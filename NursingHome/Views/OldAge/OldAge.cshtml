@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "OldAge";
}
<div class="col-md-12">
    @Html.Partial("~/Partialviews/_SearchBar.cshtml")
</div>


<!-- Modal -->
<input type="text" id="titleValue" value="@ViewData["Title"]" hidden />

<div class="modal fade" id="oldAgePopup" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="custom-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Resident Admission &amp; Intake</h5>
                <button type="button" class="close" data-dismiss="modal" onclick="HidePopup('oldAgePopup')" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body registrationFormContent">
                <form id="oldAgeAdmissionForm" novalidate>
                    <input type="hidden" id="oldAgePatientId" />
                    @await Html.PartialAsync("_AdmissionFormSections")
                    <table class="table table-bordered legacy-fields" aria-hidden="true">
                        <tbody>
                            <tr>
                                <td colspan="2">
                                    <div class="row mt-2">
                                        <div class="col-3">
                                            <img src="~/images/VedhanthOldAgeNew.png" style="height:70px;width:90px" />
                                        </div>
                                        <div class="col-6 contentCenter">
                                            <label style="font-family:fantasy;font-size:50px;color:red;letter-spacing:5px">VEDHANTH</label>

                                        </div>
                                        <div class="col-3 contentEnd">
                                            <img src="~/images/VedhanthLatestLogo.png" style="height:70px;width:90px" />
                                        </div>
                                        <div class="col-2"></div>
                                        <div class="col-8 contentCenter" style="margin-top:-20px">
                                            <label style="font-size:26px;color:red;margin-top:-5px;font-weight:500">Home Nursing Helpline</label>
                                        </div>
                                    </div>
                                    <div id="customAddress">
                                        <div class="contentCenter">
                                            <span id="customAdreesLine1" style="font-weight:500;font-size:smaller;">No.69,New No. 6/1, 1st Cross, 3rd Main Road, Mathikere, Bengaluru-560 054.</span>
                                        </div>
                                        <div class="contentCenter">
                                            <span id="customAdreesLine2" style="font-weight:500;font-size:smaller;">Mob : <span id="cutomMobileNumbers"></span> Email : <span id="customEmailAddress"></span></span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>

                                <td colspan="2">
                                    <div class="row mt-2">
                                        <label for="" class="col-7 contentEnd" style="color:red;font-size:medium;font-weight:500">OLD AGE ADMISSION FORM:</label>
                                        <div class="row col-5 ">

                                            <span class="col-5">No :</span>
                                            <input class="col-7 mt-1" id="serialNo" type="number" style="height:25px" min="0" />
                                        </div>
                                        <div class="col-7"></div>
                                        <div class="row col-5 mt-2 contentEnd">
                                            <span class="col-5">Date :</span>
                                            <input class="col-7 requiredfield" id="adminssionDate" type="date" />
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="patientName">Patient Name:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields requiredfield" id="patientName"></td>
                            </tr>
                            <tr>
                                <td><label for="address">Address:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="address"></td>
                            </tr>
                            <tr>
                                <td><label for="patientAge">Patient Age:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="patientAge"></td>
                            </tr>
                            <tr>
                                <td><label for="patientCondition">Patient Condition:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="patientCondition"></td>
                            </tr>
                            <tr>
                                <td><label for="customerName">Customer Name:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="customerName"></td>
                            </tr>
                            <tr>
                                <td><label for="mobileNo">Mobile No:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="mobileNo"></td>
                            </tr>
                            <tr>
                                <td><label for="typesOfService">Types of Service:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="typesOfService"></td>
                            </tr>
                            <tr>
                                <td><label for="idProof">ID Proof:</label></td>
                                <td>
                                    <div class="row col-12">
                                        <div class="col-10">
                                            <input type="file" class="form-control" id="legacy-idProof" accept="image/jpeg,image/jpg,image/png,application/pdf">
                                            <div id="legacy-idProofStatus" class="mt-1 small" style="display:none;"></div>
                                        </div>
                                        <div class="col-2 contentEnd">
                                            <i id="legacy-downloadIdProof" class="fa-solid fa-download fa-lg  mt-3 "></i>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="registrationCharges">Registration Charges:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="legacy-registrationCharges"></td>
                            </tr>
                            <tr>
                                <td><label for="monthlyPayment">Monthly Payment Rs:</label></td>
                                <td><input type="text" class="form-control  OldAgeIpfields" id="legacy-monthlyPayment"></td>
                            </tr>
                            <tr>
                                <td><label for="periodFrom">Period From:</label></td>
                                <td><input type="date" class="form-control  OldAgeIpfields" id="legacy-periodFrom"></td>
                            </tr>
                            <tr>
                                <td><label for="periodTo">To:</label></td>
                                <td><input type="date" class="form-control  OldAgeIpfields" id="legacy-periodTo"></td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div>
                                        <b>Terms and Conditions for Client:</b>
                                        <div style="display: flex; flex-direction: column;">
                                            <div style="display: flex; margin-top: 10px;">
                                                <div style="width: 50px; font-weight: bold; text-align: center;">1.</div>
                                                <div style="flex: 1; text-align: left;">We give with patients attender and nursing staff with emergency doctor visit.</div>
                                            </div>

                                            <div style="display: flex; margin-top: 10px;">
                                                <div style="width: 50px; font-weight: bold; text-align: center;">2.</div>
                                                <div style="flex: 1; text-align: left;">Three times food and tea, coffee (daily changes of food).</div>
                                            </div>

                                            <div style="display: flex; margin-top: 10px;">
                                                <div style="width: 50px; font-weight: bold, text-align: center;">3.</div>
                                                <div style="flex: 1; text-align: left;">We don't allow outside food and we don't provide any event foods for patients.</div>
                                            </div>

                                            <div style="display: flex; margin-top: 10px;">
                                                <div style="width: 50px; font-weight: bold; text-align: center;">4.</div>
                                                <div style="flex: 1; text-align: left;">We don't gives any personal medication to patients (BP, SUGAR TABLETS DIAPER HAND GLOVES UNDER PAD/PATIENTS AU THINGS).</div>
                                            </div>

                                            <div style="display: flex; margin-top: 10px;">
                                                <div style="width: 50px; font-weight: bold; text-align: center;">5.</div>
                                                <div style="flex: 1; text-align: left;">If the patient's discharge days are fewer than the advance payment balance, the remaining amount should be returned to the client.</div>
                                            </div>

                                            <div style="display: flex; margin-top: 10px;">
                                                <div style="width: 50px; font-weight: bold; text-align: center;">6.</div>
                                                <div style="flex: 1; text-align: left;">In case patient death non refund advance amount.</div>
                                            </div>
                                        </div>

                                        <b> Declaration</b></br>
                                        <div style="display: flex; margin-top: 5px;margin-bottom:20px">
                                            <div style="width: 20px; font-weight: bold; text-align: center;"> </div>
                                            <div style="flex: 1; text-align: left;">
                                                I hereby read, I heard all the above terms and conditions and agree to sign up with VEDHANTH Home Care for my service requirement.
                                            </div>
                                        </div>
                                        @*<div class="row">

                                        <span class="col-4">Signature of the Client</span>
                                        <span class="col-4"></span>
                                        <span class="col-4 contentEnd">Authorised Signatory</span>
                                        </div>*@
                                        <div class="signature-section row ml-2">
                                            <div class="signature-box col-4 ">
                                                <canvas id="clientSignature" class="signatureContainer"></canvas>
                                                <img id="clientSignatureImage" class="signatureContainerImage" hidden />
                                                <div class="row">
                                                    <div class="col-10">
                                                        <p>Signature of the Client &nbsp;&nbsp;&nbsp;   <i class="fa-solid fa-arrows-rotate refreshSign" onclick="clearSignature('clientSignature')"></i></p>
                                                    </div>
                                                    <div class="col-2">
                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-4"></div>
                                            <div class="signature-box col-4">
                                                <canvas id="authorizedSignature" class="signatureContainer"></canvas>
                                                <img id="authorizedSignatureImage" class="signatureContainerImage" hidden />
                                                <div class="row">
                                                    <p>Authorised Signatory  &nbsp;&nbsp;&nbsp;<i class="fa-solid fa-arrows-rotate refreshSign" onclick="clearSignature('authorizedSignature')"></i></p>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="HidePopup('oldAgePopup')" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" onclick="OpenQRPopup()">Pay</button>
                <button type="button" class="btn btn-success" id="saveAdmissionButton" onclick="AddOldAge()">Save admission</button>
                <button id="downloadRegistrationForm" class="btn btn-info">Download PDF</button>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mb-2 mt-2 page-add-btn">
    <button type="button" class="customBtn" onclick="openOldAgeForm()">
        <i class="fa fa-add me-1"></i> Add
    </button>
</div>
<div class="col-md-12 container-fluid">
    <table id="tblOldAge" class="display table-bordered rct-table" style="width:100%">
        <thead>
            <tr>
                <th>Patient Name</th>
                <th>Admission Date</th>
                <th>Period From</th>
                <th>Period To</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
    @Html.Partial("~/Partialviews/_VerifyFace.cshtml")
</div>
<style>
    .loader {
        display: none;
        position: fixed;
        z-index: 9999;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

        .loader .spinner {
            border: 8px solid #f3f3f3;
            border-top: 8px solid #3498db;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Column labels for mobile card view — layout handled by site.css (.rct-table) */
    @@media (max-width: 767px) {
        #tblOldAge td:nth-child(1)::before { content: "Patient Name"; }
        #tblOldAge td:nth-child(2)::before { content: "Admission Date"; }
        #tblOldAge td:nth-child(3)::before { content: "Period From"; }
        #tblOldAge td:nth-child(4)::before { content: "Period To"; }
    }

    /* Modal responsiveness */
    @@media screen and (max-width: 768px) {
        .custom-modal-dialog {
            width: 95% !important;
            margin: 1rem auto !important;
        }

        .modal-body {
            padding: 15px;
        }

        .modal-body table tr td:first-child {
            display: block;
            width: 100%;
            font-weight: bold;
            padding-bottom: 5px;
        }

        .modal-body table tr td:last-child {
            display: block;
            width: 100%;
            padding-top: 5px;
        }

        .signature-section {
            flex-direction: column !important;
        }

        .signature-box {
            width: 100% !important;
            margin-bottom: 20px;
        }

        .modal-footer {
            flex-wrap: wrap;
            gap: 5px;
        }

        .modal-footer button {
            flex: 1 1 45%;
            margin: 2px;
        }
    }

    @@media screen and (max-width: 576px) {
        .container-fluid {
            padding: 10px;
        }

        .customBtn {
            width: 100%;
            margin-bottom: 10px;
        }

        .modal-footer button {
            flex: 1 1 100%;
        }
    }
</style>
<div id="oldAgeLoader" class="loader"><div class="spinner"></div></div>
<script>

        var OldAgeIdProof;
        var OldAgeIdProofProcessing = false;
        function updateUploadProcessingState() {
            $('#clearAdmissionButton').prop('disabled', admissionViewOnly || OldAgeIdProofProcessing || medicalDocumentsProcessing);
        }
        async function openOldAgeForm() {
            try {
                // Use the authenticated server-side session to determine whether
                // face verification is required. Admins can open the form directly.
                var currentUser = window.currentUser;
                if (typeof currentUser === 'undefined') {
                    currentUser = await $.ajax({
                        type: "GET",
                        url: '@Url.Action("GetCurrentUser", "Users")'
                    });
                }

                if (!currentUser) {
                    alertMessage("Your session has expired. Please log in again.");
                    return;
                }

                var role = String(currentUser.roles || currentUser.Roles || '').trim().toLowerCase();
                if (role === 'admin') {
                    Clearfields();
                    return;
                }

                await verifyFace(currentUser.userName || currentUser.UserName);
            } catch (error) {
                console.error("Unable to open the Old Age form:", error);
                alertMessage("Unable to open the form. Please try again.");
            }
        }

        $(document).ready(function () {

            $('#tblOldAge').on('click', '.btn-view, .btn-edit', function () {
                loadAdmissionData($(this).attr('data-id'), $(this).hasClass('btn-view'));
            });
            $('#tblOldAge').on('click', '.btn-delete', function () {
                var ID = Number($(this).attr('data-id'));
                confirmDelete(ID);
            });
            $('#tblOldAge').on('click', '.btn-sign-link', function () {
                var itemId = $(this).attr('data-id');
                var baseUrl = '@Configuration["ClientSignatureBaseUrl"]';
                var link = baseUrl + '/OldAge/ClientSignature?id=' + itemId;
                $('#clientSignatureLink').val(link);
                $('#clientSignatureLinkContainer').show();
                $('html, body').animate({ scrollTop: $('#clientSignatureLinkContainer').offset().top }, 400);
            });
            $('#tblOldAgePayment').on('click', '.btn-edit', function () {
                var fullData = JSON.parse($(this).attr('data-full-data'));
                BindPaymentData(fullData);
            });
            $('#tblOldAgePayment').on('click', '.btn-delete', function () {
                var ID = Number($(this).attr('data-id'));
                confirmDelete(ID);
            });
            $('#search').on('click', function () {
                GetData();
            });

        })

        document.getElementById('downloadRegistrationForm').addEventListener('click', async function () {

            function getPDFSignatureSrc(canvasId, imgId) {
                var canvas = document.getElementById(canvasId);
                var img = document.getElementById(imgId);
                if (canvas && !canvas.hidden) {
                    var ctx = canvas.getContext('2d');
                    var buf = new Uint32Array(ctx.getImageData(0, 0, canvas.width, canvas.height).data.buffer);
                    if (buf.some(function (c) { return c !== 0; })) return canvas.toDataURL('image/png');
                }
                if (img && !img.hidden && img.src && img.src.length > 50) return img.src;
                return '';
            }

            await generateRegistrationPDF({
                filename:          ($('#PatientName').val() || 'resident') + '.pdf',
                formTitle:         'OLD AGE ADMISSION FORM:',
                serialNo:          $('#AdmissionNo').val() || $('#serialNo').val(),
                date:              $('#AdmissionDate').val(),
                addressLine1:      $('#customAdreesLine1').text().trim(),
                mobileNumbers:     $('#cutomMobileNumbers').text().trim(),
                email:             $('#customEmailAddress').text().trim(),
                fields: (function () {
                    var fields = [];
                    var seen = {};
                    var multi = ['MedicalConditions', 'AssistanceRequired', 'MentalMemoryConditions', 'ServicesSelected'];
                    document.querySelectorAll('#admissionFormSections [data-property]').forEach(function (field) {
                        var property = field.dataset.property;
                        if (seen[property]) return;
                        seen[property] = true;
                        var controls = document.querySelectorAll('#admissionFormSections [data-property="' + property + '"]');
                        var value = '';
                        if (multi.includes(property)) {
                            value = Array.from(controls).filter(function (control) { return control.checked; }).map(function (control) { return control.value; }).join(', ');
                        } else if (field.type === 'radio') {
                            var checked = Array.from(controls).find(function (control) { return control.checked; });
                            value = checked ? checked.value : '';
                        } else if (field.type === 'checkbox') {
                            value = field.checked ? 'Yes' : 'No';
                        } else {
                            value = field.value || '';
                        }
                        var label = field.closest('.admission-field')?.querySelector('label,.admission-field-label')?.textContent?.trim() || property;
                        fields.push({ label: label.replace(/\*/g, '').trim(), value: value });
                    });
                    fields.push({ label: 'Admission / Registration Fee (₹)', value: $('#registrationCharges').val() || '' });
                    fields.push({ label: 'Monthly Accommodation Fee (₹)', value: $('#monthlyPayment').val() || '' });
                    fields.push({ label: 'Period From', value: $('#periodFrom').val() || '' });
                    fields.push({ label: 'Period To', value: $('#periodTo').val() || '' });
                    fields.push({ label: 'Identity Proof', value: $('#idProof')[0].files.length ? $('#idProof')[0].files[0].name : (OldAgeIdProof ? 'Uploaded' : '') });
                    fields.push({ label: 'Medical Documents', value: $('#medicalFilesStatus').text() || '' });
                    return fields;
                })(),
                termsTitle:        'Terms, Conditions & Declaration',
                terms: [
                    'The center will provide the agreed accommodation, attendant and nursing support, with emergency doctor visits arranged as per the services available and agreed.',
                    'Meals and refreshments will be provided according to the center\'s daily schedule and the agreed care plan.',
                    'Outside food and special event food are subject to the center\'s approval and applicable care or dietary requirements.',
                    'Personal medicines, diapers, hand gloves, underpads and other individual medical or hygiene supplies are to be provided by the resident or family unless otherwise agreed in writing.',
                    'If the resident is discharged before the end of a prepaid period, any refundable balance will be calculated according to the written payment and refund policy agreed at admission.',
                    'In the event of a resident\'s death, any advance or outstanding amount will be settled according to the written agreement and applicable law. The center should explain the policy to the family before admission.'
                ],
                declarationText:   'I/We confirm that the information provided is accurate to the best of my/our knowledge, and that I/we have read and understood the admission terms and care arrangements.',
                clientSignSrc:     getPDFSignatureSrc('clientSignatureNew', 'clientSignatureNewImage'),
                authorizedSignSrc: getPDFSignatureSrc('authorizedSignatureNew', 'authorizedSignatureNewImage')
            });
        });

        function isAllowedAdmissionDocument(file) {
            var extension = file.name.split('.').pop().toLowerCase();
            var allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];
            var allowedTypes = ['application/pdf', 'image/jpeg', 'image/jpg', 'image/png'];
            return allowedExtensions.includes(extension) && (!file.type || allowedTypes.includes(file.type));
        }

        $('#idProof').on('change', function (event) {
            var $input = $(this);
            var $status = $('#idProofStatus');
            var selectedFile = event.target.files && event.target.files[0];
            if (!selectedFile) return;
            if (!isAllowedAdmissionDocument(selectedFile)) {
                $input.val('');
                alertMessage('Identity proof must be a PDF, JPG, or PNG file.');
                return;
            }
            OldAgeIdProof = '';
            OldAgeIdProofProcessing = true;
            updateUploadProcessingState();
            $status.text('Processing file, please wait…');
            $status.show();
            $input.prop('disabled', true);

            ConvertToBase64(event.target).then(function (base64) {
                OldAgeIdProof = base64;
                var originalSizeMB = (selectedFile.size / (1024 * 1024)).toFixed(2);
                $status.text('File ready (' + originalSizeMB + ' MB)');
                $input.prop('disabled', false);
                OldAgeIdProofProcessing = false;
                updateUploadProcessingState();
            }).catch(function (err) {
                OldAgeIdProof = '';
                $input.val('');
                $input.prop('disabled', false);
                OldAgeIdProofProcessing = false;
                updateUploadProcessingState();
                $status.text(typeof err === 'string' ? err : 'Unable to process the file. Please try again.');
                alertMessage(typeof err === 'string' ? err : 'Failed to process file. Please try again.');
            });
        });

        document.getElementById('downloadIdProof').addEventListener('click', function () {
            if (OldAgeIdProof) {
                const mimeType = OldAgeIdProof.split("~")[0];
                const fileName = ($('#PatientName').val() || 'resident') + "_IdProof.";

                downloadFile(OldAgeIdProof.split("~")[1], mimeType, fileName);
            } else {
                alertMessage('No file available to download');
            }
        });
        function downloadFile(base64String, fileType, fileName) {
            const link = document.createElement('a');
            link.href = `data:${fileType};base64,${base64String}`;
            link.download = fileName + fileType.split("/")[1];
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function Clearfields() {
            var form = document.getElementById('oldAgeAdmissionForm');
            if (form) form.reset();
            $('.OldAgeIpfields').val('');
            $('#oldAgePatientId').val('');
            admissionViewOnly = false;
            $('#admissionFormSections').find('input,select,textarea').prop('disabled', false);
            $('#clearAdmissionButton,.clear-admission-signature').prop('disabled', false);
            $('#saveAdmissionButton').prop('hidden', false);
            $('#oldAgePopup .modal-title').text('Resident Admission & Intake');
            $('#oldAgePopup .modal-footer button[onclick="OpenQRPopup()"], #downloadRegistrationForm').prop('hidden', false);
            clearSignature('authorizedSignatureNew');
            clearSignature('clientSignatureNew');
            $('#authorizedSignatureNewImage,#clientSignatureNewImage').attr('src', '').prop('hidden', true);
            $('#authorizedSignatureNew,#clientSignatureNew').prop('hidden', false);
            OldAgeIdProof = '';
            OldAgeIdProofProcessing = false;
            OldAgeMedicalDocuments = '';
            OldAgePaymentStatus = 'Pending';
            medicalDocumentsProcessing = false;
            updateUploadProcessingState();
            $('#idProofStatus').hide().text('');
            $('#medicalFilesStatus').text('');
            GetSerialNo();
            var today = formatDate(new Date());
            $('#AdmissionDate').val(today);
            $('#SignedDate').val(today);
            $('#adminssionDate').val(today);
            $('#periodFrom').val(today);
            $('#periodTo').val('');
            $('#admissionFormSections').find('input,select,textarea').first().trigger('input');
            showPopup('oldAgePopup');
        }

        function GetSerialNo() {
            $.get({
                url: '@Url.Action("GetLatestID", "OldAge")',
                success: function (response) {
                    $('#serialNo').val(response);
                    if (!$('#AdmissionNo').val()) {
                        $('#AdmissionNo').val('VAC-' + new Date().getFullYear() + '-' + String(response).padStart(3, '0'));
                    }
                },
                error: function (response) {
                }
            });
        }

        function isCanvasBlank(canvas) {
            const context = canvas.getContext('2d');
            const pixelBuffer = new Uint32Array(
                context.getImageData(0, 0, canvas.width, canvas.height).data.buffer
            );
            return !pixelBuffer.some(color => color !== 0);
        }


        var OldAgeMedicalDocuments = '';
        var OldAgePaymentStatus = 'Pending';
        var admissionViewOnly = false;
        var medicalDocumentsProcessing = false;

        function readMultiSelection(value) {
            if (!value) return [];
            try {
                var parsed = JSON.parse(value);
                return Array.isArray(parsed) ? parsed.map(String) : [];
            } catch (_) {
                return String(value).split(',').map(function (item) { return item.trim(); }).filter(Boolean);
            }
        }

        function parseSavedMedicalDocuments(value) {
            if (!value) return [];
            try {
                var parsed = JSON.parse(value);
                return Array.isArray(parsed) ? parsed : [{ fileName: 'Previously saved document', legacyValue: value }];
            } catch (_) {
                return [{ fileName: 'Previously saved document', legacyValue: value }];
            }
        }

        function updateMedicalDocumentsStatus(value) {
            var status = $('#medicalFilesStatus');
            if (!value) {
                status.text('');
                return;
            }
            var docs = parseSavedMedicalDocuments(value);
            var names = docs.map(function (document) { return document.fileName || 'Previously saved document'; });
            status.text(names.length ? names.length + ' saved document' + (names.length === 1 ? '' : 's') + ': ' + names.join(', ') : 'Previously saved document retained');
        }

        $('#medicalFiles').on('change', async function (event) {
            var selectedFiles = Array.from(event.target.files || []);
            if (!selectedFiles.length) return;
            var totalBytes = selectedFiles.reduce(function (total, file) { return total + file.size; }, 0);
            if (totalBytes > 10 * 1024 * 1024 || selectedFiles.some(function (file) { return file.size > 5 * 1024 * 1024 || !isAllowedAdmissionDocument(file); })) {
                alertMessage('Select PDF, JPG, or PNG files. Each must be 5 MB or less and the combined upload must be 10 MB or less.');
                event.target.value = '';
                return;
            }
            medicalDocumentsProcessing = true;
            updateUploadProcessingState();
            $(this).prop('disabled', true);
            $('#medicalFilesStatus').text('Processing selected documents…');
            try {
                var newDocuments = await Promise.all(selectedFiles.map(function (file) {
                    return new Promise(function (resolve, reject) {
                        var reader = new FileReader();
                        reader.onload = function () { resolve({ fileName: file.name, contentType: file.type || 'application/octet-stream', dataUrl: reader.result }); };
                        reader.onerror = function () { reject(new Error('Could not read ' + file.name)); };
                        reader.readAsDataURL(file);
                    });
                }));
                var previousDocuments = parseSavedMedicalDocuments(OldAgeMedicalDocuments);
                OldAgeMedicalDocuments = JSON.stringify(previousDocuments.concat(newDocuments));
                $('input[data-property="MedicalDocumentsAttached"][value="true"]').prop('checked', true);
                updateMedicalDocumentsStatus(OldAgeMedicalDocuments);
            } catch (error) {
                $('#medicalFilesStatus').text('Unable to read the selected documents. Please try again.');
                alertMessage(error.message || 'Unable to read the selected documents.');
            } finally {
                medicalDocumentsProcessing = false;
                $('#medicalFiles').prop('disabled', false);
                updateUploadProcessingState();
            }
        });

        function getSignatureValue(canvasId, imageId) {
            var canvas = document.getElementById(canvasId);
            var image = document.getElementById(imageId);
            if (canvas && !isCanvasBlank(canvas)) {
                return canvas.toDataURL('image/png').replace(/^data:image\/(png|jpg);base64,/, '');
            }
            if (image && image.getAttribute('src')) {
                return image.getAttribute('src').replace(/^data:image\/(png|jpg);base64,/, '');
            }
            return '';
        }

        function AddOldAge() {
            if (admissionViewOnly) return;
            if (medicalDocumentsProcessing || OldAgeIdProofProcessing) {
                alertMessage('Please wait until the selected files have finished processing.');
                return;
            }
            var form = document.getElementById('oldAgeAdmissionForm');
            if (!form.reportValidity()) return;

            var data = {};
            data.Id = $('#oldAgePatientId').val() || 0;
            document.querySelectorAll('#admissionFormSections [data-property]').forEach(function (field) {
                var property = field.dataset.property;
                if (['MedicalConditions', 'AssistanceRequired', 'MentalMemoryConditions', 'ServicesSelected'].includes(property)) {
                    if (!Object.prototype.hasOwnProperty.call(data, property)) {
                        var selected = Array.from(document.querySelectorAll('#admissionFormSections [data-property="' + property + '"]:checked')).map(function (item) { return item.value; });
                        data[property] = JSON.stringify(selected);
                    }
                    return;
                }
                if (field.type === 'radio') {
                    if (field.checked) data[property] = field.value;
                    else if (!Object.prototype.hasOwnProperty.call(data, property)) data[property] = null;
                    return;
                }
                if (field.type === 'checkbox') {
                    data[property] = field.checked;
                    return;
                }
                data[property] = field.value === '' ? null : field.value;
            });

            data.PatientName = $('#PatientName').val();
            data.Address = $('#Address').val();
            data.Age = $('#Age').val();
            data.Condition = $('#PresentHealthCondition').val();
            data.CustomerName = $('#GuardianName').val();
            data.MobileNo = $('#MobileNo').val();
            data.TypesofServices = readMultiSelection(data.ServicesSelected).join(', ').slice(0, 200);
            data.IdProof = OldAgeIdProof || null;
            data.PaymentStatus = data.Id ? OldAgePaymentStatus : 'Pending';
            data.PeriodFrom = $('#periodFrom').val() || null;
            data.PeriodTo = $('#periodTo').val() || null;
            data.AdmissionDate = $('#AdmissionDate').val() || null;
            data.MonthlyPayment = $('#monthlyPayment').val() || null;
            data.RegistrationCharges = $('#registrationCharges').val() || null;
            data.MedicalDocuments = OldAgeMedicalDocuments || null;
            data.SUser = localStorage.getItem('username');
            $('#patientName').val(data.PatientName);
            $('#address').val(data.Address);
            $('#patientAge').val(data.Age);
            $('#patientCondition').val(data.Condition);
            $('#customerName').val(data.CustomerName);
            $('#mobileNo').val(data.MobileNo);
            $('#typesOfService').val(data.TypesofServices);
            $('#adminssionDate').val(data.AdmissionDate);

            data.authorizedSign = getSignatureValue('authorizedSignatureNew', 'authorizedSignatureNewImage');
            data.clientSign = getSignatureValue('clientSignatureNew', 'clientSignatureNewImage');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("AddorEditOldAge", "OldAge")',
                data: data,
                success: function (response) {
                    if (response) {
                        var wasNew = !$('#oldAgePatientId').val();
                        var id = wasNew ? response : $('#oldAgePatientId').val();
                        $('#oldAgePatientId').val(id);
                        HidePopup('oldAgePopup');
                        msgPopup('success', wasNew ? 'Admission added successfully' : 'Admission updated successfully');
                        GetData();
                        var baseUrl = '@Configuration["ClientSignatureBaseUrl"]';
                        $('#clientSignatureLink').val(baseUrl + '/OldAge/ClientSignature?id=' + id);
                        $('#clientSignatureLinkContainer').show();
                    } else {
                        msgPopup('error', 'Unable to save this admission. Please try again.');
                    }
                },
                error: function (response) {
                    console.error(response);
                    msgPopup('error', 'Unable to save this admission. Please check the form and try again.');
                }
            });
        }

        function toDateInput(value) {
            if (!value) return '';
            var parsed = new Date(value);
            return Number.isNaN(parsed.getTime()) ? '' : formatDate(parsed);
        }

        function setSavedSignature(canvasId, imageId, value) {
            var canvas = document.getElementById(canvasId);
            var image = document.getElementById(imageId);
            var signature = value ? String(value).trim() : '';
            if (signature) {
                image.src = signature.indexOf('data:image/') === 0 ? signature : 'data:image/png;base64,' + signature;
                image.hidden = false;
                canvas.hidden = true;
            } else {
                image.src = '';
                image.hidden = true;
                canvas.hidden = false;
                clearSignature(canvasId);
            }
        }

        function BindData(data, viewOnly) {
            admissionViewOnly = viewOnly === true;
            $('#oldAgePatientId').val(data.id || '');
            OldAgePaymentStatus = data.paymentStatus || 'Pending';
            OldAgeIdProof = data.idProof || '';
            OldAgeMedicalDocuments = data.medicalDocuments || '';
            updateMedicalDocumentsStatus(OldAgeMedicalDocuments);

            var multiProperties = ['MedicalConditions', 'AssistanceRequired', 'MentalMemoryConditions', 'ServicesSelected'];
            var seenProperties = {};
            document.querySelectorAll('#admissionFormSections [data-property]').forEach(function (field) {
                var property = field.dataset.property;
                if (seenProperties[property]) return;
                seenProperties[property] = true;
                var key = property.charAt(0).toLowerCase() + property.slice(1);
                var value = data[key] !== undefined ? data[key] : data[property];
                var group = document.querySelectorAll('#admissionFormSections [data-property="' + property + '"]');
                if (multiProperties.includes(property)) {
                    var selected = readMultiSelection(value);
                    group.forEach(function (option) { option.checked = selected.includes(option.value); });
                } else if (field.type === 'radio') {
                    group.forEach(function (option) { option.checked = value != null && String(option.value).toLowerCase() === String(value).toLowerCase(); });
                } else if (field.type === 'checkbox') {
                    field.checked = value === true || String(value).toLowerCase() === 'true' || value === 1;
                } else if (field.type === 'date') {
                    field.value = toDateInput(value);
                } else {
                    field.value = value == null ? '' : value;
                }
            });

            $('#serialNo').val(data.admissionNo || data.id || '');
            $('#AdmissionNo').val(data.admissionNo || data.id || '');
            $('#patientName').val(data.patientName || '');
            $('#address').val(data.address || '');
            $('#patientAge').val(data.age == null ? '' : data.age);
            $('#patientCondition').val(data.condition || data.presentHealthCondition || '');
            if (!data.presentHealthCondition && data.condition) $('#PresentHealthCondition').val(data.condition);
            $('#customerName').val(data.customerName || data.guardianName || '');
            $('#mobileNo').val(data.mobileNo || '');
            $('#typesOfService').val(data.typesofServices || '');
            if (!data.guardianName && data.customerName) $('#GuardianName').val(data.customerName);
            if (!data.guardianMobileNo && data.mobileNo) $('#GuardianMobileNo').val(data.mobileNo);
            if (!data.servicesSelected && data.typesofServices) {
                var legacyServices = readMultiSelection(data.typesofServices).map(function (service) { return service.toLowerCase(); });
                var serviceOptions = document.querySelectorAll('#admissionFormSections [data-property="ServicesSelected"]');
                var matchedLegacyService = false;
                serviceOptions.forEach(function (option) {
                    option.checked = legacyServices.includes(option.value.toLowerCase());
                    if (option.checked) matchedLegacyService = true;
                });
                if (!matchedLegacyService) $('#OtherService').val(data.typesofServices);
            }
            if (OldAgeIdProof) $('#idProofStatus').text('Existing identity proof saved').show();
            $('#periodFrom').val(toDateInput(data.periodFrom));
            $('#periodTo').val(toDateInput(data.periodTo));
            $('#adminssionDate').val(toDateInput(data.admissionDate));
            $('#monthlyPayment').val(data.monthlyPayment == null ? '' : data.monthlyPayment);
            $('#registrationCharges').val(data.registrationCharges == null ? '' : data.registrationCharges);
            updateMedicalDocumentsStatus(OldAgeMedicalDocuments);
            setSavedSignature('clientSignatureNew', 'clientSignatureNewImage', data.clientSign);
            setSavedSignature('authorizedSignatureNew', 'authorizedSignatureNewImage', data.authorizedSign);

            $('#admissionFormSections').find('input,select,textarea').prop('disabled', admissionViewOnly);
            $('.clear-admission-signature').prop('disabled', admissionViewOnly);
            updateUploadProcessingState();
            $('#saveAdmissionButton').prop('hidden', admissionViewOnly);
            $('#oldAgePopup .modal-title').text(admissionViewOnly ? 'Admission Details' : 'Resident Admission & Intake');
            $('#oldAgePopup .modal-footer button[onclick="OpenQRPopup()"], #downloadRegistrationForm').prop('hidden', admissionViewOnly);
            $('#AdmissionNo').trigger('input');
            showPopup('oldAgePopup');
        }

        function loadAdmissionData(id, viewOnly) {
            $.get({
                url: '@Url.Action("GetAdmissionData", "OldAge")',
                data: { id: id },
                success: function (admission) { BindData(admission, viewOnly); },
                error: function (response) {
                    console.error(response);
                    alertMessage('Unable to load this admission. Please try again.');
                }
            });
        }

        function confirmDelete(id) {
            $.alert({
                title: 'Alert',
                content: 'Are you sure want to delete ?',
                typeAnimated: true,
                backgroundDismiss: false,
                backgroundDismissAnimation: 'glow',
                boxWidth: '30%',
                useBootstrap: false,
                buttons: {
                    Yes: {
                        text: 'Yes',
                        btnClass: 'btn btn-success',
                        action: function () {
                            deleteData(id);
                        },
                    },
                    No: {
                        text: 'No',
                        btnClass: 'btn btn-warning',
                        action: function () {
                            return;
                        },
                    },
                },
            });
        }
        function deleteData(id) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteData", "OldAge")',
                data: { id: id },
                success: function (response) {
                    if (response) {
                        msgPopup("success", "Data Deleted Successfully");
                        GetData();
                    } else {
                        msgPopup("error", "Error! Please Try Again");
                    }
                },
                error: function (response) {

                    console.error(response);
                }
            });
        }
         function copySignatureLink() {
            var copyText = document.getElementById('clientSignatureLink');
            copyText.select();
            copyText.setSelectionRange(0,99999);
            document.execCommand('copy');
            msgPopup('success', 'Link copied to clipboard!');
        }

        function GetData() {
            var table = $('#tblOldAge').DataTable();
            let startDate = $('#startDate').val();
            let endDate = $('#endDate').val();
            let user = $('#ddlUsers').val();
            $('#oldAgeLoader').show();
            $.get({
                url: '@Url.Action("GetData", "OldAge")',
                data: { startDate: startDate, endDate: endDate, username: user },
                success: function (response) {
                    table.clear().draw();
                    response.data.forEach(function (item) {
                        var safePatientName = $('<div>').text(item.patientName || '').html();
                        table.row.add([
                            safePatientName,
                            item.admissionDate ? item.admissionDate.split("T")[0] : null,
                            item.periodFrom ? item.periodFrom.split("T")[0] : null,
                            item.periodTo ? item.periodTo.split("T")[0] : null,
                            '<div class="contentCenter">' +
                            '<button type="button" class="btn btn-link btn-sm p-0 me-3 btn-view" style="color:#24685c;" title="View details" aria-label="View admission details for ' + safePatientName + '" data-id="' + item.id + '"><i class="fa fa-eye" aria-hidden="true"></i></button>' +
                            '<button type="button" class="btn btn-link btn-sm p-0 me-3 btn-edit" style="color:green;" title="Edit" aria-label="Edit admission for ' + safePatientName + '" data-id="' + item.id + '"><i class="fa fa-edit" aria-hidden="true"></i></button>' +
                            '<button type="button" class="btn btn-link btn-sm p-0 me-3 btn-sign-link" style="color:#0d6efd;" title="Send Signature Link" aria-label="Send signature link for ' + safePatientName + '" data-id="' + item.id + '"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>' +
                            '<button type="button" class="btn btn-link btn-sm p-0 btn-delete" style="color:red;" title="Delete" aria-label="Delete admission for ' + safePatientName + '" data-id="' + item.id + '"><i class="fa fa-trash" aria-hidden="true"></i></button>' +
                            '</div>'
                        ]).draw();
                    });
                    $('#oldAgeLoader').hide();
                    },
                    error: function (response) {
                    $('#oldAgeLoader').hide();
                    console.error(response);
                    }
            });
        }

</script>
<div id="clientSignatureLinkContainer" style="margin-top:10px;display:none;">
    <label>Share this link with the client to capture their signature:</label>
    <input type="text" id="clientSignatureLink" readonly style="width:80%;" />
    <button onclick="copySignatureLink()" class="btn btn-info">Copy Link</button>
</div>
