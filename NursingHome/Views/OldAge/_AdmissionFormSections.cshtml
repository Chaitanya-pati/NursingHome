    .admission-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 18px;border-bottom:1px solid var(--admission-line);background:#fff}.admission-progress{min-width:150px;color:var(--admission-muted);font-size:11px;font-weight:700}.admission-progress-track{height:6px;margin-top:5px;overflow:hidden;border-radius:8px;background:#e9efec}.admission-progress-track span{display:block;width:0;height:100%;background:var(--admission-accent);transition:width .2s}.admission-toolbar-actions{display:flex;flex-wrap:wrap;gap:8px}
