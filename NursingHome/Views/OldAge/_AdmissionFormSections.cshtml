dding:9px 10px;background:#fff;color:var(--admission-ink);font:inherit;outline:none;transition:border .15s,box-shadow .15s}.admission-field textarea{min-height:76px;resize:vertical}.admission-field input:focus,.admission-field select:focus,.admission-field textarea:focus{border-color:var(--admission-primary-2);box-shadow:0 0 0 3px #24685c18}.admission-choice-row,.admission-check-grid{display:flex;flex-wrap:wrap;gap:8px}.admission-check-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.admission-choice{display:inline-flex!important;align-items:flex-start;gap:7px;margin:0!important;border:1px solid var(--admission-line);border-radius:8px;padding:7px 9px;background:#fff;color:var(--admission-ink)!important;font-size:11px!important;font-weight:500!important;cursor:pointer}.admission-choice input{flex:0 0 auto;margin:2px 0 0;accent-color:var(--admission-primary)}.admission-note{border:1px solid #f0dfb9;border-radius:9px;padding:11px 13px;background:#fff8e9;color:#6c572b;font-size:11px}.admission-upload-box{border:1px dashed #b8cbc1;border-radius:9px;padding:11px;background:#f8fbf9}.admission-upload-box input,.admission-upload-row input{width:100%;font-size:11px}.admission-upload-row{display:flex;align-items:center;gap:10px}.admission-upload-status{margin-top:5px;color:var(--admission-muted);font-size:11px}.admission-terms{padding:16px}.admission-terms ol{margin:0 0 14px;padding-left:22px}.admission-terms li{margin-bottom:8px;padding-left:4px;color:#485b54;font-size:11px}.admission-declaration{margin-top:15px!important;line-height:1.6}.admission-signature-pad{height:120px;overflow:hidden;border:1px dashed #aebfb6;border-radius:9px;background:linear-gradient(#fff,#fbfdfc)}.admission-signature-pad .signatureContainer,.admission-signature-pad .signatureContainerImage{width:100%;height:100%;background:transparent;touch-action:none}.admission-signature-pad canvas{display:block;cursor:crosshair}.admission-signature-actions{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:6px}.admission-signature-actions small{color:var(--admission-muted);font-size:10px}.admission-footer{display:flex;justify-content:space-between;gap:10px;margin-top:16px;color:#7b8983;font-size:10px}
    @@media(max-width:850px){.admission-field{grid-column:span 6}.admission-check-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.admission-form-body{padding:15px}}
    @@media(max-width:560px){.admission-hero{align-items:flex-start;gap:12px;padding:18px 14px}.admission-brand-mark{width:52px;height:52px;flex-basis:52px;border-radius:13px;font-size:21px}.admission-eyebrow{font-size:9px;letter-spacing:1px}.admission-hero p{font-size:11px}.admission-toolbar{align-items:flex-start;padding:10px}.admission-progress{min-width:108px}.admission-toolbar-actions{justify-content:flex-end}.admission-button{padding:7px 8px;font-size:10px}.admission-form-body{padding:11px}.admission-intro{display:block;padding-bottom:13px}.admission-required-note{display:block;margin-top:7px}.admission-section-head{padding:11px}.admission-section-body{gap:12px;padding:12px}.admission-field,.admission-field.span-6,.admission-field.span-8,.admission-field.span-12{grid-column:1/-1}.admission-check-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.admission-choice{padding:7px;font-size:10px!important}.admission-footer{flex-direction:column}.admission-upload-row{align-items:stretch;flex-direction:column}.admission-upload-row .admission-button{width:100%}}
    @@media print{.admission-form{background:#fff}.admission-hero{-webkit-print-color-adjust:exact;print-color-adjust:exact}.admission-toolbar,.admission-signature-actions{display:none!important}.admission-section{break-inside:avoid}.admission-section-head{-webkit-print-color-adjust:exact;print-color-adjust:exact}.admission-form-body{padding:12px}}
</style>
<script>
    (function () {
        const root = document.getElementById('admissionFormSections');
        if (!root) return;
        const updateProgress = function () {
            const fields = Array.from(root.querySelectorAll('input:not([type=checkbox]):not([type=radio]):not([type=file]),select,textarea'));
            const filled = fields.filter(function (field) { return String(field.value || '').trim() !== ''; }).length;
            const percentage = fields.length ? Math.round((filled / fields.length) * 100) : 0;
            document.getElementById('admissionProgressText').textContent = percentage + '% completed';
            document.querySelector('.admission-progress-track').setAttribute('aria-valuenow', percentage);
            document.getElementById('admissionProgressFill').style.width = percentage + '%';
        };
        root.addEventListener('input', updateProgress);
        root.addEventListener('change', updateProgress);
        document.getElementById('clearAdmissionButton').addEventListener('click', function () {
            if (!window.confirm('Clear all entered admission information?')) return;
            var form = document.getElementById('oldAgeAdmissionForm');
            if (form) form.reset();
            $('#oldAgePatientId').val('');
            OldAgeIdProof = '';
            OldAgeMedicalDocuments = '';
            OldAgePaymentStatus = 'Pending';
            OldAgeIdProofProcessing = false;
            medicalDocumentsProcessing = false;
            $('#medicalFiles').prop('disabled', false);
            updateUploadProcessingState();
            $('#idProofStatus').hide().text('');
            $('#medicalFilesStatus').text('');
            $('#clientSignatureNewImage,#authorizedSignatureNewImage').attr('src', '').prop('hidden', true);
            $('#clientSignatureNew,#authorizedSignatureNew').prop('hidden', false);
            clearSignature('clientSignatureNew');
            clearSignature('authorizedSignatureNew');
            var today = new Date().toISOString().slice(0, 10);
            ['AdmissionDate', 'periodFrom', 'SignedDate'].forEach(function (id) { document.getElementById(id).value = today; });
            document.getElementById('periodTo').value = '';
            GetSerialNo();
            updateProgress();
        });
        root.querySelectorAll('.clear-admission-signature').forEach(function (button) {
            button.addEventListener('click', function () {
                var canvas = document.getElementById(button.dataset.canvas);
                var image = canvas.parentElement.querySelector('img');
                clearSignature(button.dataset.canvas);
                if (image) { image.src = ''; image.hidden = true; }
                canvas.hidden = false;
            });
        });
        const today = new Date().toISOString().slice(0, 10);
        ['AdmissionDate', 'periodFrom', 'SignedDate'].forEach(function (id) {
            const field = document.getElementById(id);
            if (field && !field.value) field.value = today;
        });
        updateProgress();
    })();
</script>
