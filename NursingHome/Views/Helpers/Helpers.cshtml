            });
        }

        function deleteData(id) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DeleteData", "Helpers")',
                data: { id: id },
                success: function (response) {
                    if (response) {
                        msgPopup("success", "Data Deleted Successfully");
                        GetData();
                    } else {
                        msgPopup("error", "Error! Please Try Again");
                    }
                },
                error: function (response) {

                }
            });
        }

        function closeIdCardModal() {
            document.getElementById('idCardIframe').src = '';
            HidePopup('idCardModal');
        }

        function idCardPrint() {
            var iframe = document.getElementById('idCardIframe');
            if (iframe && iframe.contentWindow) {
                iframe.contentWindow.focus();
                iframe.contentWindow.print();
            }
        }

        function idCardDownloadPDF() {
            var iframe = document.getElementById('idCardIframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.downloadPDF === 'function') {
                iframe.contentWindow.downloadPDF();
            }
        }

        function GetCityDetails() {
            let username = localStorage.getItem('username');
            $.ajax({
                url: '/Configuration/CityDetails',
                type: 'GET',
                dataType: 'json',
                data: { username: username },
                success: function (response) {
                    $('#customAdreesLine1').text(response.officeAddress);
                    $('#cutomMobileNumbers').text(response.mobileNumbers);
                    $('#customEmailAddress').text(response.email);
                },
                error: function (xhr, status, error) {
                    console.error(xhr.responseText);
                }
            });
        }

        // ── Helpers ───────────────────────────────────────────────────────────────
        function escAttr(v) { return v == null ? '' : String(v).replace(/'/g,"&#39;").replace(/"/g,'&quot;'); }
        function fmtDate(v) { if (!v) return '—'; var d = new Date(v); return isNaN(d) ? '—' : d.toLocaleDateString(); }
        function fmtDateTime(v) { if (!v) return '—'; var d = new Date(v); return isNaN(d) ? '—' : d.toLocaleString(); }

        // ── Assign / Change User ─────────────────────────────────────────────────
        var _assignUsersCache = [];
        var _currentAssignTab = 'existing';

        // Delegate: Assign User button
        $('#tblHelpers').on('click', '.btn-assign-user', function () {
            var helperId   = JSON.parse($(this).attr('dataId'));
            var helperName = $(this).attr('data-helper-name') || '';
            var helperDob  = $(this).attr('data-dob') || '';
            openAssignUserModal(helperId, helperName, helperDob);
        });

        // Delegate: Remove Assignment button
        $('#tblHelpers').on('click', '.btn-remove-user', function () {
            var helperId = JSON.parse($(this).attr('dataId'));
            var suser    = $(this).attr('data-suser') || '';
            $('#removeHelperId').val(helperId);
            $('#removeAssignedUsername').text(suser);
            showPopup('removeAssignmentModal');
        });

        // Delegate: Reset Password button
        $('#tblHelpers').on('click', '.btn-reset-password', function () {
            var helperId = JSON.parse($(this).attr('dataId'));
            var suser    = $(this).attr('data-suser') || '';
            $('#resetHelperId').val(helperId);
            $('#resetUserName').text(suser);
            $('#resetNewPassword, #resetConfirmPassword').val('');
            $('#resetError').hide();
            showPopup('resetPasswordModal');
        });

        // Delegate: View assigned user info badge click
        $('#tblHelpers').on('click', '.badge-success', function () {
            var helperId   = $(this).attr('data-helper-id');
            var helperName = $(this).attr('data-helper-name') || '';
            if (helperId) loadAssignedUserPanel(helperId, helperName);
        });

        function switchAssignTab(tab) {
            _currentAssignTab = tab;
            if (tab === 'existing') {
                $('#tab-existing').addClass('active');
                $('#tab-new').removeClass('active');
                $('#panelExisting').show();
                $('#panelNew').hide();
                $('#btnConfirmAssignUser').show();
                $('#btnCreateAndAssign').hide();
            } else {
                $('#tab-new').addClass('active');
                $('#tab-existing').removeClass('active');
                $('#panelNew').show();
                $('#panelExisting').hide();
                $('#btnConfirmAssignUser').hide();
                $('#btnCreateAndAssign').show();
            }
        }

        // Track current suser for modal remove/reset actions
        var _modalCurrentSuser = '';
        var _modalCurrentHelperId = 0;

        function openResetFromModal() {
            $('#resetHelperId').val(_modalCurrentHelperId);
            $('#resetUserName').text(_modalCurrentSuser);
            $('#resetNewPassword, #resetConfirmPassword').val('');
            $('#resetError').hide();
            HidePopup('assignUserModal');
            showPopup('resetPasswordModal');
        }

        function openRemoveFromModal() {
            $('#removeHelperId').val(_modalCurrentHelperId);
            $('#removeAssignedUsername').text(_modalCurrentSuser);
            HidePopup('assignUserModal');
            showPopup('removeAssignmentModal');
        }

        // Stored DOB year for auto-fill password generation
        var _modalHelperDobYear = '';

        function autoFillFromName() {
            var fullName = $('#nuFullName').val() || '';
            var firstName = fullName.split(' ')[0] || '';

            // Password: first 4 chars of full name (lowercase) + DOB year
            var namePart = fullName.substring(0, 4).toLowerCase();
            var pwd = namePart + (_modalHelperDobYear || '');
            if (pwd.length >= 4) {
                $('#nuPassword').val(pwd);
                $('#nuConfirmPassword').val(pwd);
                $('#nuConfirmPwdHint').hide();
            }

            // Ask the server for a guaranteed-unique username suggestion
            if (!firstName) {
                $('#nuUserName').val('');
                $('#nuUserNameHint').hide();
                return;
            }

            $.ajax({
                url: '/Users/SuggestUsername',
                type: 'GET',
                data: { firstName: firstName },
                success: function (res) {
                    if (res && res.suggestion) {
                        $('#nuUserName').val(res.suggestion);
                        $('#nuUserNameHint')
                            .html('<i class="fas fa-check-circle" style="color:#27ae60"></i> <em>' +
                                  res.suggestion + '</em> — auto-suggested, you can change this')
                            .show();
                    }
                },
                error: function () {
                    // Fallback: use the first word as before so the form still works
                    $('#nuUserName').val(firstName.toLowerCase());
                    $('#nuUserNameHint').hide();
                }
            });
        }

        function openAssignUserModal(helperId, helperName, helperDob) {
            $('#assignHelperId').val(helperId);
            $('#assignModalTitle').text('Assign User — ' + (helperName || ''));
            _modalCurrentHelperId = helperId;
            _modalCurrentSuser = '';

            // Extract DOB year for password generation
            _modalHelperDobYear = '';
            if (helperDob) {
                var dobDate = new Date(helperDob);
                if (!isNaN(dobDate)) _modalHelperDobYear = String(dobDate.getFullYear());
            }

            // Reset state
            $('#nuFullName, #nuUserName, #nuMobile, #nuEmail, #nuPassword, #nuConfirmPassword').val('');
            $('#nuRole').val('helper');
            $('#nuIsActive').val('true');
            $('#nuError').hide();
            $('#nuConfirmPwdHint').hide();
            $('#assignUserDetails').hide();
            $('#auAlreadyAssignedWarn').hide();
            $('#assignCurrentBanner').hide();
            $('#assignNoBanner').hide();
            $('#btnConfirmAssignUser').prop('disabled', true);
            switchAssignTab('existing');

            // Load current assignment info to show banner
            var uIdCheck = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetAssignedUserInfo", "Helpers")',
                data: { helperId: helperId, userId: uIdCheck },
                success: function (r) {
                    if (r.success && r.assigned) {
                        _modalCurrentSuser = r.userName || '';
                        $('#acbUserName').text(r.userName || '');
                        $('#acbUserRole').text(r.role ? '(' + r.role + ')' : '');
                        $('#assignCurrentBanner').show();
                        $('#assignNoBanner').hide();
                        // Pre-fill the "Full Name" field in Create New tab from helper name
                        $('#nuFullName').val(helperName || '');
                        autoFillFromName();
                    } else {
                        $('#assignCurrentBanner').hide();
                        $('#assignNoBanner').show();
                        $('#nuFullName').val(helperName || '');
                        autoFillFromName();
                    }
                },
                error: function () {
                    $('#assignNoBanner').show();
                }
            });

            // Auto-fill helper name in Create New tab
            // (will be replaced after helper data fetched)

            // Init Select2 once
            if (!$('#assignUserSelect').hasClass('select2-hidden-accessible')) {
                $('#assignUserSelect').select2({
                    dropdownParent: $('#assignUserModal'),
                    placeholder: '-- Search by name, username, role or mobile --',
                    allowClear: true,
                    width: '100%'
                });

                $('#assignUserSelect').on('select2:select', function () {
                    var uid  = $(this).val();
                    var user = _assignUsersCache.find(function (u) { return String(u.id) === String(uid); });
                    if (user) {
                        $('#auDetailName').text(user.fullName || '—');
                        $('#auDetailUsername').text(user.userName || '—');
                        $('#auDetailRole').text(user.role || '—');
                        $('#auDetailMobile').text(user.mobileNo || '—');
                        $('#assignUserDetails').show();

                        // Block if user is already assigned to a different helper
                        if (user.isAssignedElsewhere) {
                            $('#auAlreadyAssignedWarn').show();
                            $('#btnConfirmAssignUser').prop('disabled', true);
                        } else {
                            $('#auAlreadyAssignedWarn').hide();
                            $('#btnConfirmAssignUser').prop('disabled', false);
                        }
                    }
                });

                $('#assignUserSelect').on('select2:unselect select2:clear', function () {
                    $('#assignUserDetails').hide();
                    $('#auAlreadyAssignedWarn').hide();
                    $('#btnConfirmAssignUser').prop('disabled', true);
                });
            }

            var uId = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';

            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetUsersForAssign", "Helpers")',
                data: { userId: uId, helperId: helperId },
                success: function (response) {
                    if (!response.success) { msgPopup('error', 'Failed to load users.'); return; }
                    _assignUsersCache = response.data;
                    var $sel = $('#assignUserSelect');
                    $sel.find('option:not(:first)').remove();
                    // Only include users NOT already assigned to another helper
                    response.data.forEach(function (u) {
                        if (u.isAssignedElsewhere) return; // skip — already taken by another helper
                        var label = (u.fullName || u.userName) + ' (' + (u.role || 'N/A') + ') — ' + (u.mobileNo || '');
                        if (u.isThisHelper) label += ' [Currently Assigned]';
                        $sel.append(new Option(label, u.id, false, false));
                    });
                    $sel.trigger('change');
                    showPopup('assignUserModal');
                },
                error: function () { msgPopup('error', 'Error loading users. Please try again.'); }
            });
        }

        function closeAssignUserModal() {
            HidePopup('assignUserModal');
        }

        function confirmAssignUser() {
            var helperId       = $('#assignHelperId').val();
            var selectedUserId = $('#assignUserSelect').val();
            if (!selectedUserId) { msgPopup('warning', 'Please select a user to assign.'); return; }

            var user = _assignUsersCache.find(function (u) { return String(u.id) === String(selectedUserId); });
            if (!user) { msgPopup('error', 'Selected user not found.'); return; }
            if (user.isAssignedElsewhere) { msgPopup('error', 'This user is already assigned to another helper and cannot be reassigned.'); return; }

            var uId = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            var $btn = $('#btnConfirmAssignUser').prop('disabled', true);
            $('#btnAssignLabel').text('Assigning…');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("AssignUserToHelper", "Helpers")',
                data: { helperId: helperId, targetUserId: user.id, userId: uId },
                success: function (r) {
                    $btn.prop('disabled', false);
                    $('#btnAssignLabel').text('Assign User');
                    if (r.success) {
                        closeAssignUserModal();
                        msgPopup('success', r.message || 'User assigned successfully.');
                        GetData();
                    } else {
                        msgPopup('error', r.message || 'Failed to assign user.');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false);
                    $('#btnAssignLabel').text('Assign User');
                    msgPopup('error', 'Error assigning user. Please try again.');
                }
            });
        }

        function confirmCreateAndAssign() {
            var helperId    = $('#assignHelperId').val();
            var fullName    = $('#nuFullName').val().trim();
            var userName    = $('#nuUserName').val().trim();
            var mobile      = $('#nuMobile').val().trim();
            var email       = $('#nuEmail').val().trim();
            var password    = $('#nuPassword').val();
            var confirmPwd  = $('#nuConfirmPassword').val();
            var role        = $('#nuRole').val();
            var isActive    = $('#nuIsActive').val() === 'true';

            $('#nuError').hide();

            if (!fullName)   { showNuError('Full Name is required.'); return; }
            if (!userName)   { showNuError('Username is required.'); return; }
            if (!password)   { showNuError('Password is required.'); return; }
            if (password !== confirmPwd) { showNuError('Passwords do not match.'); return; }
            if (password.length < 4)    { showNuError('Password must be at least 4 characters.'); return; }

            // Split fullName into first/last
            var nameParts = fullName.split(' ');
            var firstName = nameParts[0] || fullName;
            var lastName  = nameParts.slice(1).join(' ') || '';

            var uId = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            var $btn = $('#btnCreateAndAssign').prop('disabled', true).text('Creating…');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("CreateAndAssignUser", "Helpers")',
                data: {
                    helperId: helperId, firstName: firstName, lastName: lastName,
                    userName: userName, password: password, mobileNo: mobile,
                    email: email, role: role, isActive: isActive, userId: uId
                },
                success: function (r) {
                    $btn.prop('disabled', false).html('<i class="fas fa-user-plus mr-1"></i> Create &amp; Assign');
                    if (r.success) {
                        closeAssignUserModal();
                        msgPopup('success', r.message || 'User created and assigned.');
                        GetData();
                    } else {
                        showNuError(r.message || 'Failed to create user.');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-user-plus mr-1"></i> Create &amp; Assign');
                    showNuError('Server error. Please try again.');
                }
            });
        }

        function showNuError(msg) {
            $('#nuError').text(msg).show();
        }

        // ── Remove Assignment ─────────────────────────────────────────────────────
        function confirmRemoveAssignment() {
            var helperId = $('#removeHelperId').val();
            var uId      = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            var $btn = $('#btnConfirmRemove').prop('disabled', true).text('Removing…');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("RemoveUserAssignment", "Helpers")',
                data: { helperId: helperId, userId: uId },
                success: function (r) {
                    $btn.prop('disabled', false).html('<i class="fas fa-user-times mr-1"></i> Remove Assignment');
                    HidePopup('removeAssignmentModal');
                    if (r.success) {
                        msgPopup('success', r.message || 'Assignment removed.');
                        $('#assignedUserPanel').hide();
                        GetData();
                    } else {
                        msgPopup('error', r.message || 'Failed to remove assignment.');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-user-times mr-1"></i> Remove Assignment');
                    msgPopup('error', 'Error removing assignment.');
                }
            });
        }

        // ── Reset Password ────────────────────────────────────────────────────────
        function confirmResetPassword() {
            var helperId   = $('#resetHelperId').val();
            var newPwd     = $('#resetNewPassword').val();
            var confirmPwd = $('#resetConfirmPassword').val();
            $('#resetError').hide();

            if (!newPwd)              { $('#resetError').text('Password is required.').show(); return; }
            if (newPwd.length < 4)    { $('#resetError').text('Password must be at least 4 characters.').show(); return; }
            if (newPwd !== confirmPwd) { $('#resetError').text('Passwords do not match.').show(); return; }

            var uId  = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            var $btn = $('#btnConfirmReset').prop('disabled', true).text('Resetting…');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("ResetHelperPassword", "Helpers")',
                data: { helperId: helperId, newPassword: newPwd, userId: uId },
                success: function (r) {
                    $btn.prop('disabled', false).html('<i class="fas fa-key mr-1"></i> Reset Password');
                    if (r.success) {
                        HidePopup('resetPasswordModal');
                        msgPopup('success', r.message || 'Password reset successfully.');
                    } else {
                        $('#resetError').text(r.message || 'Failed to reset password.').show();
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-key mr-1"></i> Reset Password');
                    $('#resetError').text('Server error. Please try again.').show();
                }
            });
        }

        // ── Assigned User Info Panel ──────────────────────────────────────────────
        function loadAssignedUserPanel(helperId, helperName) {
            var uId = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            $.ajax({
                type: 'GET',
                url: '@Url.Action("GetAssignedUserInfo", "Helpers")',
                data: { helperId: helperId, userId: uId },
                success: function (r) {
                    if (!r.success || !r.assigned) {
                        $('#assignedUserPanel').hide();
                        return;
                    }
                    $('#auPanelHelperName').text(helperName || '');
                    $('#auPanelFullName').text(r.fullName || '—');
                    $('#auPanelUserName').text(r.userName || '—');
                    $('#auPanelRole').text(r.role || '—');
                    $('#auPanelStatus').html(r.isActive
                        ? '<span class="badge badge-success">Active</span>'
                        : '<span class="badge badge-secondary">Inactive</span>');
                    $('#auPanelLastLogin').text(fmtDateTime(r.lastLogin));
                    $('#auPanelCreatedDate').text(fmtDate(r.createdDate));
                    $('#auPanelMobile').text(r.mobileNo || '—');
                    $('#auPanelEmail').text(r.email || '—');
                    $('#assignedUserPanel').show();
                    $('html, body').animate({ scrollTop: $('#assignedUserPanel').offset().top - 80 }, 400);
                },
                error: function () { /* non-critical */ }
            });
        }

        function closeAssignedUserPanel() {
            $('#assignedUserPanel').hide();
        }

        // ── Clear All User Assignments ────────────────────────────────────────────
        function openClearAllModal() {
            showPopup('clearAllAssignmentsModal');
        }

        function confirmClearAllAssignments() {
            var uId = localStorage.getItem('userId') || localStorage.getItem('userID') || '0';
            var $btn = $('#btnConfirmClearAll').prop('disabled', true).text('Clearing…');

            $.ajax({
                type: 'POST',
                url: '@Url.Action("ClearAllUserAssignments", "Helpers")',
                data: { userId: uId },
                success: function (r) {
                    $btn.prop('disabled', false).html('<i class="fas fa-user-slash mr-1"></i> Yes, Clear All');
                    HidePopup('clearAllAssignmentsModal');
                    if (r.success) {
                        msgPopup('success', r.message || 'All assignments cleared.');
                        $('#assignedUserPanel').hide();
                        GetData();
                    } else {
                        msgPopup('error', r.message || 'Failed to clear assignments.');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-user-slash mr-1"></i> Yes, Clear All');
                    msgPopup('error', 'Server error. Please try again.');
                }
            });
        }
</script>

