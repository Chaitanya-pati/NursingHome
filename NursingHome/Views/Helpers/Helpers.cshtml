        function previewImage(event) {
            var input = event.target;
            var reader = new FileReader();

            if (input.files && input.files[0]) {
                reader.onload = function (e) {
                    var output = document.getElementById('preview-image');
                    output.src = e.target.result;
                }

                reader.readAsDataURL(input.files[0]);
            } else {
                alert("Failed to load file");
            }
        }
        // CRUD Operation
        function AddHelper() {
            if (CheckEmptyFields()) {
                var data = {};
                data.Id = $('#helperId').val();
                data.Name = $('#candidateName').val();
                data.ParentName = $('#parentName').val();
                data.Image = candidateImage;
                data.DateOfBirth = $('#candidateDOB').val();
                data.MaritalStatus = $('#maritalStatus').val();
                data.PermanentAddress = $('#permanentAddress').val();
                data.PresentAddress = $('#presentAddress').val();
                data.IdProof = helperIdProof;
                data.Education = $('#education').val();
                data.LanguagesKnown = $('#languages').val();
                data.Experience = $('#experience').val();
                data.Salary = $('#salary').val();
                data.Reference = $('#referenceDetail').val();
                data.FamilyMembers = $('#famMembers').val();
                data.suser = localStorage.getItem('username');
                data.candidateSign = $('#clientSignature')[0].toDataURL("image/png").replace(/^data:image\/(png|jpg);base64,/, "");
                data.Place = $('#place').val();
                data.admissionDate = $('#admissionDate').val();
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("AddorEditHelper", "Helpers")',
                    data: data,
                    success: function (response) {
                        var isNew = $('#helperId').val() == '';
                        var ok    = response === true || (response && response.success);
                        if (ok) {
                            HidePopup('helperModal');
                            GetData();

                            if (isNew && response.autoUser) {
                                // Show auto-generated credentials so admin can hand them to the helper
                                $.alert({
                                    title: '<i class="fa fa-user-check" style="color:#27ae60"></i> Helper Added — Login Credentials',
                                    content:
                                        '<p class="mb-2">A login account has been automatically created for this helper.</p>' +
                                        '<table class="table table-sm table-bordered mb-2">' +
                                          '<tr><th style="width:110px">Username</th><td><strong id="credUser">' + (response.autoUser.userName || '') + '</strong></td></tr>' +
                                          '<tr><th>Password</th><td><strong id="credPass">' + (response.autoUser.password || '') + '</strong></td></tr>' +
                                        '</table>' +
                                        '<p class="small text-muted mb-0">Please note these down and share with the helper.<br>The password can be changed anytime from the helper\'s profile.</p>',
                                    type: 'green',
                                    boxWidth: '440px',
                                    useBootstrap: false,
                                    buttons: {
                                        OK: { text: 'Got it', btnClass: 'btn btn-success' }
                                    }
                                });
                            } else if (isNew && response.autoUserError) {
                                // Helper saved, but auto user-creation failed
                                msgPopup("success", "Helper added. Note: auto user-creation failed — " + response.autoUserError + ". Please assign a user manually.");
                            } else {
                                msgPopup("success", isNew ? "Helper Added Successfully" : "Data Updated Successfully");
                            }
                        } else {
                            var errMsg = (response && response.message) ? response.message : "Error! Please Try Again";
                            msgPopup("error", errMsg);
                        }
                    },
                    error: function (response) {

                        console.error(response);
                    }
                });
            }
        }

        function BindData(data) {
            $('#helperId').val(data.id);
