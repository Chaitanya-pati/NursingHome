            await new Promise(function(r){ requestAnimationFrame(function(){ requestAnimationFrame(r); }); });

            try {
                var canvas = await html2canvas(el, {
                    scale:       2,
                    useCORS:     true,
                    allowTaint:  true,
                    logging:     false,
                    width:       CONTENT_PX,
                    windowWidth: CONTENT_PX,
