<script>
        var candidateImage = "";
        var helperIdProof = "";

        $(document).ready(function () {
            GetData();
            GetCityDetails();

            // Show "Clear All Assignments" button only for admin
            if (localStorage.getItem('userRole') === 'admin') {
                $('#btnClearAllAssignments').show();
            }

            // Auto-fill username and password when Full Name is typed
            $('#nuFullName').on('input', autoFillFromName);

            // Live password-match hint for Create New User form
            $('#nuPassword, #nuConfirmPassword').on('input', function () {
                var pwd  = $('#nuPassword').val();
                var cpwd = $('#nuConfirmPassword').val();
                if (cpwd.length === 0) {
                    $('#nuConfirmPwdHint').hide();
                } else {
                    $('#nuConfirmPwdHint').toggle(pwd !== cpwd);
                }
            });
        });

        document.getElementById('downloadRegistrationForm').addEventListener('click', async function () {
            var filename = ($('#candidateName').val() || 'helper') + '.pdf';

            /* ── helpers ── */
            function esc(s) {
                return s == null ? '' : String(s)
                    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
                    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }
            function val(id) {
                var el = document.getElementById(id);
                return el ? (el.value || '') : '';
            }
            async function toDataUri(url) {
                try {
                    var blob = await (await fetch(url)).blob();
                    return await new Promise(function(res) {
                        var fr = new FileReader();
                        fr.onload  = function(e) { res(e.target.result); };
                        fr.onerror = function()  { res(''); };
                        fr.readAsDataURL(blob);
                    });
                } catch(e) { return ''; }
            }

            /* ── fetch logos ── */
            var base  = window.location.origin;
            var logos = await Promise.all([
                toDataUri(base + '/images/Subramanya.png'),
                toDataUri(base + '/images/vedhant%20icon.png')
            ]);
            var logoL = logos[0] ? '<img src="'+logos[0]+'" style="height:100px;width:140px;object-fit:contain;display:block;">' : '';
            var logoR = logos[1] ? '<img src="'+logos[1]+'" style="height:62px;width:80px;object-fit:contain;display:block;">' : '';

            /* ── candidate photo ── */
            var previewImg = document.getElementById('preview-image');
            var photoSrc   = (previewImg && previewImg.src && previewImg.naturalWidth > 0) ? previewImg.src : '';
            var photoHtml  = photoSrc
                ? '<img src="'+photoSrc+'" style="height:78px;width:78px;object-fit:cover;border:1px solid #ccc;display:block;">'
                : '<div style="height:78px;width:78px;border:1px solid #ccc;"></div>';

            /* ── address from DOM ── */
            function txt(id) { var e=document.getElementById(id); return e ? e.textContent.trim() : ''; }
            var addr1  = txt('customAdreesLine1');
            var mobNos = txt('cutomMobileNumbers');
            var email  = txt('customEmailAddress');

            /* ── signature ── */
            var sigEl  = document.getElementById('clientSignatureImage');
            var sigCv  = document.getElementById('clientSignature');
            var sigSrc = '';
            if (sigEl && !sigEl.hidden && sigEl.src) {
                sigSrc = sigEl.src;
            } else if (sigCv && sigCv.width > 0) {
                sigSrc = sigCv.toDataURL('image/png');
            }
            var sigHtml = sigSrc
                ? '<img src="'+sigSrc+'" style="max-width:130px;max-height:52px;object-fit:contain;display:block;">'
                : '<div style="height:52px;"></div>';

            /* ── field rows ── */
            var KA = 'font-family:\'Noto Sans Kannada\',Arial,sans-serif;';
            var fields = [
                { l:'ಪೂರ್ಣ ಹೆಸರು:',                              v:val('candidateName') },
                { l:'ತಂದೆ / ಪತಿಯ ಹೆಸರು:',                       v:val('parentName') },
                { l:'ಹುಟ್ಟಿದ ದಿನ:',                               v:val('candidateDOB') },
                { l:'ವೈವಾಹಿಕ ಸ್ಥಿತಿ:',                           v:val('maritalStatus') },
                { l:'ಶಾಶ್ವತ ವಿಳಾಸ & ಸಂಪರ್ಕ ಸಂಖ್ಯೆ:',             v:val('permanentAddress') },
                { l:'ಪ್ರಸ್ತುತ ವಿಳಾಸ & ಸಂಪರ್ಕ ಸಂಖ್ಯೆ:',            v:val('presentAddress') },
                { l:'ಶೈಕ್ಷಣಿಕ ಅರ್ಹತೆ:',                          v:val('education') },
                { l:'ತಿಳಿದ ಭಾಷೆಗಳು:',                             v:val('languages') },
                { l:'ಅನುಭವ (ಸಂಪೂರ್ಣ ವಿವರ ನೀಡಿ):',               v:val('experience') },
                { l:'ವೈಯಕ್ತಿಕ ಗುರುತಿನ ಪುರಾವೆ:',                  v:'' },
                { l:'ಕೇಟುಮಾಡಿದ ವೇತನ:',                           v:val('salary') },
                { l:'ಮಾಹಿತಿ (ಹೆಸರು, ವಿಳಾಸ & ಸಂಪರ್ಕ ಸಂಖ್ಯೆ):',   v:val('referenceDetail') },
                { l:'ಕುಟುಂಬದ ವಿವರಗಳು:',                          v:val('famMembers') }
            ];
            var TD_L = 'style="width:38%;padding:5px 9px;border:1px solid #999;font-size:11.5px;font-weight:600;vertical-align:middle;word-break:break-word;'+KA+'"';
            var TD_R = 'style="width:62%;padding:5px 9px;border:1px solid #999;font-size:11.5px;vertical-align:middle;word-break:break-word;"';
            var fieldsHtml = fields.map(function(f){
                return '<tr><td '+TD_L+'>'+esc(f.l)+'</td><td '+TD_R+'>'+esc(f.v)+'</td></tr>';
            }).join('');

            /* ── rules section ── */
            function ruleSection(title, items) {
                var lis = items.map(function(t){ return '<li style="margin-bottom:4px;">'+t+'</li>'; }).join('');
                return '<h4 style="text-align:center;color:red;font-size:13px;margin:10px 0 5px;'+KA+'">'+title+'</h4>' +
                       '<ul style="font-size:11px;list-style-type:disc;margin-left:18px;line-height:1.55;'+KA+'">'+lis+'</ul>';
            }
            var rulesHtml =
                ruleSection('ಪಾಲಿಸಬೇಕಾದ ಸಂಸ್ಥೆಯ ನಿಯಮಗಳು ಮತ್ತು ನಿಯಂತ್ರಣ',[
                    'ಸಿಬ್ಬಂದಿಯು ಕನಿಷ್ಠ 3 ತಿಂಗಳು ಯಾವುದೇ ರಜೆ ಇಲ್ಲದೆ ಕೆಲಸ ಮಾಡಬೇಕು ತುರ್ತು ಪರಿಸ್ಥಿತಿಗೆ ಅನುಮತಿ ನೀಡಲಾಗುವುದು ಆದರೆ ಅದನ್ನು ಸಿಬ್ಬಂದಿಯ ತಂದೆ ತಾಯಿ ಮಾತ್ರ ತಿಳಿಸಬೇಕು.',
                    'ಸಿಬ್ಬಂದಿಯ ಕುಟುಂಬಸ್ಥರ ಸಾವು ಆದಲ್ಲಿ ವಿಡಿಯೋ ಕಾಲ್ ಮುಖಾಂತರ ತಿಳಿಸಿ ಹೋಗತಕ್ಕದ್ದು.',
                    'ಒಂದು ವೇಳೆ ಸಿಬ್ಬಂದಿ 30 ದಿನಗಳ ಒಳಗೆ ಮನೆಗೆ ತೆರಳಲು ಬಯಸಿದರೆ ಸಂಬಳ ನೀಡಲಾಗುವುದಿಲ್ಲ.',
                    'ರಾಜೀನಾಮೆ ನೀಡಿದ ನಂತರ ಸಿಬ್ಬಂದಿಯು 1 ತಿಂಗಳು ಕೆಲಸ ಮಾಡಬೇಕು.',
                    'ರಜೆ ಪತ್ರ ಅಥವಾ ರಾಜೀನಾಮೆ ಪತ್ರ ನೀಡದೆ ಯಾವುದೇ ಸಿಬ್ಬಂದಿಯನ್ನು ಮನೆಗೆ ಕಳುಹಿಸುವುದಿಲ್ಲ. ರಜೆ ಪತ್ರಕ್ಕೆ ಸಂಬಳದ 70% ಪಾವತಿಸಲಾಗುವುದು ಮತ್ತು ಹಿಂತಿರುಗಿದ ನಂತರ ಉಳಿದ 30% ಪಾವತಿಸಲಾಗುವುದು.',
                    'ಕಛೇರಿಗೆ ಬರುವಾಗ ಸಿಬ್ಬಂದಿ ಗುರುತಿನ ಚೀಟಿ ಧರಿಸಬೇಕು.',
                    'ಸಂಬಳವನ್ನು ಖಾತೆಗೆ ಜಮಾ ಮಾಡಲಾಗುವುದು, ಸಿಬ್ಬಂದಿಗೆ ಯಾವುದೇ ಹಣವನ್ನು ನಗದಾಗಿ ಪಾವತಿಸುವುದಿಲ್ಲ.',
                    'ಲೆಕ್ಕ ಪರಿಶೋಧನೆಯ ಉದ್ದೇಶದಿಂದ ಸಿಬ್ಬಂದಿಗೆ ಮುಂಗಡ ಪಾವತಿ ಇಲ್ಲ.',
                    'ಸಂಬಳದ ದಿನಾಂಕವು ಪ್ರತಿ ತಿಂಗಳ 1 ರಿಂದ 30ರವರೆಗೆ ಇರುತ್ತದೆ, ಮತ್ತು ಪ್ರತಿ ತಿಂಗಳ 10ನೇ ತಾರೀಖಿಗೆ ನೀಡಲಾಗುತ್ತದೆ.',
                    'ಸಿಬ್ಬಂದಿ ರಜೆಗೆ ಸಂಬಂಧಿಸಿದಂತೆ ಮ್ಯಾನೇಜರ್‌ಗೆ ಯಾವುದೇ ಬ್ಲಾಕ್ ಮೇಲ್ ಮಾಡಬೇಡಿ. ಬ್ಲ್ಯಾಕ್ ಮೇಲ್‌ಗಳನ್ನು ಕಂಡುಕೊಂಡರೆ ಸಂಬಳದ 10% ಕಡಿತಗೊಳಿಸಲಾಗುತ್ತದೆ.',
                    'ಯಾವುದೇ ಪುರಾವೆಗಳಿಲ್ಲದೆ ಕಛೇರಿಯಲ್ಲಿ ಹಿಂಸೆ ಇಲ್ಲ. ಯಾವುದೇ ದೂರುಗಳನ್ನು ಆದ್ಯತೆಯಾಗಿ ತೆಗೆದುಕೊಳ್ಳಲಾಗುವುದು.',
                    'ಯಾವುದೇ ಕಳ್ಳತನ / ಆತ್ಮಹತ್ಯೆಯ ಸಂದರ್ಭದಲ್ಲಿ ಕಂಪನಿಯು ಜವಾಬ್ದಾರರಾಗಿರುವುದಿಲ್ಲ.',
                    'ರೋಗಿಯ ಸ್ಥಳದ ಬಳಿ ಕುಟುಂಬದವರು, ನೆರೆಹೊರೆಯವರು, ಸ್ನೇಹಿತರಿಗೆ ಅನುಮತಿ ಇರುವುದಿಲ್ಲ.',
                    'ಸಂಸ್ಥೆಯ ಮೊದಲ ತಿಂಗಳ ಸಿಬ್ಬಂದಿಯು ಪೋಲೀಸ್ ಪರಿಶೀಲನೆಯನ್ನು ಮಾಡಲಿದೆ ಹಾಗೂ ರೂ.1,000/- ಕಡಿತಗೊಳಿಸಲಾಗುವುದು.'
                ]) +
                ruleSection('ಸಂಬಳ ಅಭಿವೃದ್ಧಿ',[
                    'ಸಿಬ್ಬಂದಿ ಯಾವುದೇ ರೋಗಿಯನ್ನು ಸೂಚಿಸಿದರೆ 10% ಕಮಿಷನ್ ನೀಡಲಾಗುತ್ತದೆ.',
                    'ಸಿಬ್ಬಂದಿ ಇತರ ಸಿಬ್ಬಂದಿಯನ್ನು ಉಲ್ಲೇಖಿಸಿದರೆ ಮೊದಲ ಎರಡು ತಿಂಗಳಿಗೆ ₹700/- ಪಾವತಿಸಲಾಗುವುದು.',
                    'ವೇತನವನ್ನು ವರ್ಷಕೊಮ್ಮೆ ಹೆಚ್ಚಿಸಲಾಗುವುದು.',
                    'ಹೆಚ್ಚಳವು ಪ್ರಾಮಾಣಿತವಾಗಿ 7% ಆಗಿರುತ್ತದೆ.'
                ]) +
                ruleSection('ಸಂಸ್ಥೆಯ ವಸತಿಗೃಹದ ನಿಯಮಗಳು ಮತ್ತು ನಿಯಂತ್ರಣ',[
                    'ಸಿಬ್ಬಂದಿಯು ವಸತಿಗೃಹ ನೈರ್ಮಲ್ಯ ಕಾಪಾಡಬೇಕು.',
                    'ವಸತಿಗೃಹದಲ್ಲಿ ಯಾವುದೇ ಮಧ್ಯಪಾನ, ದೂಮಪಾನ, ತಂಬಾಕು ಉಪಯೋಗಿಸುವಂತಿಲ್ಲ.',
                    'ರಾತ್ರಿ ಊಟದ ನಂತರ ಯಾರು ಹೊರಗೆ ಬರಬಾರದು. ಸಮಯದ ಮಿತಿ ರಾತ್ರಿ 10:00 ಗಂಟೆ.',
                    'ಅನುಮತಿಯಿಲ್ಲದೆ ವಸತಿ ಗೃಹದಿಂದ ಹೊರ ಬರಬಾರದು.',
