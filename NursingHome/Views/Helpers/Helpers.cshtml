                var MARGIN_MM = 7, MARGIN_T_MM = 8;
                var CW_MM = 196, CH_MM = 281;

                var jsPDFCtor = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
                var doc = new jsPDFCtor({ unit:'mm', format:'a4', orientation:'portrait' });

                var cW = canvas.width, cH = canvas.height;
                var mmPerCpx = CW_MM / cW;
                var pageHpx  = Math.floor(CH_MM / mmPerCpx);
                var total    = Math.ceil(cH / pageHpx);

                for (var p = 0; p < total; p++) {
                    if (p > 0) doc.addPage();
                    var srcY  = p * pageHpx;
                    var srcH  = Math.min(pageHpx, cH - srcY);
                    var strip = document.createElement('canvas');
                    strip.width  = cW;
                    strip.height = srcH;
                    strip.getContext('2d').drawImage(canvas, 0, srcY, cW, srcH, 0, 0, cW, srcH);
                    doc.addImage(strip.toDataURL('image/jpeg', 0.97), 'JPEG',
