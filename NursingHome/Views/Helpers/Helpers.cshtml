<style>
    .loader {
        display: none;
        position: fixed;
        z-index: 9999;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

        .loader .spinner {
            border: 8px solid #f3f3f3;
            border-top: 8px solid #3498db;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
        }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Card-view labels for Helpers grid */
    @@media (max-width: 767px) {
        #tblHelpers td:nth-child(1)::before { content: "Candidate Name"; }
        #tblHelpers td:nth-child(2)::before { content: "Permanent Address"; }
        #tblHelpers td:nth-child(3)::before { content: "Languages Known"; }
        #tblHelpers td:nth-child(4)::before { content: none; }
    }
</style>
