            type: "POST",
       data: { UserName: UserName },
            url: '@Url.Action("GetData", "Helpers")',
            success: function (response) {
       table.clear().draw();
          response.data.forEach(function (item) {
           var isAdmin = localStorage.getItem('userRole') === 'admin';
           var hasUser = item.suser && item.suser.trim() !== '';
           var assignedBadge = hasUser
               ? '<span class="badge btn-view-assigned" style="font-size:11px;cursor:pointer;background:#d4edda;color:#155724;border:1px solid #c3e6cb;font-weight:600;" data-helper-id="'+item.id+'" data-helper-name="'+escAttr(item.name)+'"><i class="fas fa-user-check mr-1"></i>'+escAttr(item.suser)+'</span>'
               : '<span class="badge" style="font-size:11px;background:#f8f9fa;color:#6c757d;border:1px solid #dee2e6;">None</span>';

           var adminAssignIcon = isAdmin
               ? ' <i class="fa fa-user-cog ml-2 btn-assign-user" title="' + (hasUser ? 'Change / Remove User Assignment' : 'Assign User') + '" style="color:#6750a4;cursor:pointer;font-size:15px;" dataId=\'' + JSON.stringify(item.id).replace(/'/g,"&#39;") + '\' data-helper-name="'+escAttr(item.name)+'" data-suser="'+escAttr(item.suser || '')+'" data-dob="'+escAttr(item.dateOfBirth || '')+'"></i>'
               : '';

           table.row.add([
         item.name,
         item.permanentAddress,
         item.languagesKnown,
         assignedBadge,
         '<i class="fa fa-edit me-2 ml-1 btn-edit" style="color:green;cursor:pointer;" data-full-data=\'' + JSON.stringify(item).replace(/'/g, "&#39;") + '\'></i>' +
         '<i class="fa fa-id-card ml-2 mr-1 btn-idcard" title="Generate ID Card" style="color:#1a5fcc;cursor:pointer;" dataId=\'' + JSON.stringify(item.id).replace(/'/g, "&#39;") + '\'></i>' +
