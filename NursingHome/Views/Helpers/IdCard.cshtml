@{
    Layout = null;
    var helperId = ViewBag.HelperId;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Helper ID Card</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            background: #eaf2fa;
            font-family: 'Segoe UI', Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 30px 16px 40px;
        }

        /* ── Page header ── */
        .page-header {
            text-align: center;
            margin-bottom: 24px;
        }
        .page-header h1 {
            font-size: 24px;
            color: #1a3a6b;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .page-header p {
            color: #5a6a80;
            font-size: 13px;
            margin-top: 4px;
        }

        /* ── Action buttons ── */
        .action-buttons {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }
        .btn-print  { background: #1a3a6b; color: #fff; }
        .btn-print:hover  { background: #142d55; }
        .btn-pdf    { background: #c0392b; color: #fff; }
        .btn-pdf:hover    { background: #a93226; }
        .btn-back   { background: #fff; color: #1a3a6b; border: 2px solid #1a3a6b; }
        .btn-back:hover   { background: #f0f4ff; }

        /* ── Card wrapper ── */
        .card-wrapper { display: flex; justify-content: center; }

        /* ══════════════════════════════════════
           THE ID CARD
           Portrait PVC — 324 px wide, auto height
           ══════════════════════════════════════ */
        .id-card {
            width: 324px;
            background-color: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(0,0,0,0.22);
            display: flex;
            flex-direction: column;
        }

        /* ── Punch hole ── */
        .punch-hole {
            display: flex;
            justify-content: center;
            padding-top: 10px;
            padding-bottom: 2px;
        }
        .punch-hole-inner {
            width: 30px;
            height: 12px;
            background: rgba(200,220,245,0.9);
            border-radius: 8px;
            box-shadow: inset 0 2px 5px rgba(0,0,0,0.18);
        }

        /* ── Header ── */
        .card-header {
            padding: 4px 14px 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .header-logo {
            width: 58px;
            height: 58px;
            object-fit: contain;
            flex-shrink: 0;
            border-radius: 8px;
        }
        .header-text { flex: 1; }
        .header-company {
            font-size: 13px;
            font-weight: 900;
            color: #1565c0;
            letter-spacing: 0.5px;
            line-height: 1.2;
            text-transform: uppercase;
        }
        .header-service {
            font-size: 10px;
            font-weight: 700;
            color: #1565c0;
            letter-spacing: 0.2px;
            line-height: 1.4;
            text-transform: uppercase;
        }
        .header-tagline {
            font-size: 8.5px;
            color: #5b8ec7;
            font-style: italic;
            margin-top: 2px;
        }

        /* ── Thin blue divider ── */
        .header-divider {
            height: 2px;
            background: linear-gradient(90deg, transparent 5%, #2563c0 30%, #2563c0 70%, transparent 95%);
            margin: 0 12px 0;
        }

        /* ── Photo section ── */
        .card-photo-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px 0 6px;
        }
        .card-photo-ring {
            width: 115px;
            height: 115px;
            border-radius: 50%;
            border: 2.5px solid #1976d2;
            padding: 3px;
            background: #fff;
        }
        .card-photo {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
            object-position: center top;
            background: #d8e8f8;
            display: block;
        }
        .photo-placeholder {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #c8dced;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .photo-placeholder i { font-size: 44px; color: #7fa0be; }

        /* ── Name + ECG + Role ── */
        .name-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 6px 10px 4px;
        }
        .name-row {
            display: flex;
            align-items: center;
            gap: 4px;
            width: 100%;
            justify-content: center;
        }
        .ecg-svg {
            flex: 1;
            height: 22px;
            max-width: 64px;
        }
        .card-name {
            font-size: 20px;
            font-weight: 800;
            color: #0d3b8c;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 180px;
            text-align: center;
        }
        .role-badge {
            margin-top: 6px;
            background: #e4edf8;
            border: 1.5px solid #b8cce4;
            color: #1565c0;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 3px 22px;
            border-radius: 20px;
        }

        /* ── Info divider ── */
        .info-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent 5%, #b8cce4 30%, #b8cce4 70%, transparent 95%);
            margin: 8px 14px 6px;
        }

        /* ── Info rows ── */
        .card-info {
            padding: 0 14px 10px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .info-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .info-icon-box {
            width: 24px;
            height: 24px;
            background: linear-gradient(135deg, #1a3a6b 0%, #2563c0 100%);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .info-icon-box i { font-size: 10px; color: #fff; }
        .info-label {
            width: 70px;
            font-size: 10px;
            color: #2a3f66;
            font-weight: 600;
            flex-shrink: 0;
        }
        .info-colon {
            font-size: 10px;
            color: #2a3f66;
            font-weight: 700;
            width: 8px;
            flex-shrink: 0;
        }
        .info-value {
            font-size: 10.5px;
            color: #111e38;
            font-weight: 700;
            flex: 1;
        }

        /* ── Footer ── */
        .card-footer {
            background: linear-gradient(135deg, #1a3a6b 0%, #2563c0 100%);
            padding: 10px 14px 11px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            margin-top: auto;
        }
        .footer-row {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 9.5px;
            color: #fff;
            font-weight: 500;
        }
        .footer-row i { font-size: 9px; color: rgba(255,255,255,0.85); }

        /* ── Loading ── */
        #loadingOverlay {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            padding: 40px;
            color: #1a3a6b;
        }
        .spinner {
            width: 44px; height: 44px;
            border: 4px solid #d0dce8;
            border-top-color: #2563c0;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* ── Print ── */
        @@media print {
            body { background: #fff; padding: 0; }
            .page-header, .action-buttons { display: none !important; }
            .card-wrapper { justify-content: center; }
            .id-card {
                width: 54mm;
                box-shadow: none;
                border-radius: 4mm;
                page-break-inside: avoid;
            }
            .card-name   { font-size: 8.5pt; }
            .header-company { font-size: 7.5pt; }
            .header-service { font-size: 4.5pt; }
            .header-tagline { font-size: 4pt; }
            .role-badge  { font-size: 4.5pt; letter-spacing: 1.5px; padding: 2px 10px; }
            .info-label, .info-colon, .info-value { font-size: 5pt; }
            .footer-row  { font-size: 4.5pt; }
            .card-photo-ring { width: 42px; height: 42px; }
        }
    </style>
</head>
<body>

    <div class="page-header">
        <h1><i class="fas fa-id-card"></i> Helper ID Card</h1>
        <p>Subramanya Home Healthcare Service — Professional Identity Card</p>
    </div>

    <div class="action-buttons">
        <button class="btn-action btn-back" onclick="history.back()">
            <i class="fas fa-arrow-left"></i> Back
        </button>
        <button class="btn-action btn-print" onclick="window.print()">
            <i class="fas fa-print"></i> Print
        </button>
        <button class="btn-action btn-pdf" onclick="downloadPDF(event)">
            <i class="fas fa-file-pdf"></i> Download PDF
        </button>
    </div>

    <div class="card-wrapper">
        <div id="loadingOverlay">
            <div class="spinner"></div>
            <span>Loading helper details…</span>
        </div>

        <!-- THE ID CARD — hidden until data loads -->
        <div id="idCardEl" class="id-card" style="display:none;">

            <!-- Punch hole -->
            <div class="punch-hole"><div class="punch-hole-inner"></div></div>

            <!-- Header: logo + company info -->
            <div class="card-header">
                <img id="companyLogo" class="header-logo" src="/Images/subramanya_latest-Logo.jpg" alt="Logo"
                     onerror="this.src='/Images/Subramanya.png'" />
                <div class="header-text">
                    <div class="header-company">SUBRAMANYA</div>
                    <div class="header-service">HOME HEALTHCARE SERVICE</div>
                    <div class="header-tagline">Your Care, Our Commitment</div>
                </div>
            </div>

            <!-- Blue divider line -->
            <div class="header-divider"></div>

            <!-- Circular photo -->
            <div class="card-photo-section">
                <div class="card-photo-ring">
                    <img id="helperPhoto" class="card-photo" src="" alt="Helper Photo" />
                </div>
            </div>

            <!-- Name flanked by ECG lines, then role badge -->
            <div class="name-section">
                <div class="name-row">
                    <!-- Left ECG pulse -->
                    <svg class="ecg-svg" viewBox="0 0 64 22" xmlns="http://www.w3.org/2000/svg">
                        <polyline
                            points="0,11 12,11 16,5 20,17 24,3 28,19 32,11 64,11"
                            fill="none" stroke="#2563c0" stroke-width="1.6"
                            stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>

                    <div class="card-name" id="helperName">—</div>

                    <!-- Right ECG pulse -->
                    <svg class="ecg-svg" viewBox="0 0 64 22" xmlns="http://www.w3.org/2000/svg">
                        <polyline
                            points="0,11 32,11 36,5 40,17 44,3 48,19 52,11 64,11"
                            fill="none" stroke="#2563c0" stroke-width="1.6"
                            stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="role-badge" id="helperRole">HELPER</div>
            </div>

            <!-- Section divider -->
            <div class="info-divider"></div>

            <!-- Info rows -->
            <div class="card-info">
                <div class="info-row" id="rowId">
                    <div class="info-icon-box"><i class="fas fa-id-badge"></i></div>
                    <span class="info-label">ID No.</span>
                    <span class="info-colon">:</span>
                    <span class="info-value" id="infoId">—</span>
                </div>
                <div class="info-row" id="rowRole">
                    <div class="info-icon-box"><i class="fas fa-user-tie"></i></div>
                    <span class="info-label">Role</span>
                    <span class="info-colon">:</span>
                    <span class="info-value" id="infoRole">Helper</span>
                </div>
                <div class="info-row" id="rowDob">
                    <div class="info-icon-box"><i class="fas fa-calendar-alt"></i></div>
                    <span class="info-label">DOB</span>
                    <span class="info-colon">:</span>
                    <span class="info-value" id="infoDob">—</span>
                </div>
                <div class="info-row" id="rowMobile">
                    <div class="info-icon-box"><i class="fas fa-phone"></i></div>
                    <span class="info-label">Mobile No.</span>
                    <span class="info-colon">:</span>
                    <span class="info-value" id="infoMobile">—</span>
                </div>
                <div class="info-row" id="rowAadhaar">
                    <div class="info-icon-box"><i class="fas fa-address-card"></i></div>
                    <span class="info-label">Aadhar No.</span>
                    <span class="info-colon">:</span>
                    <span class="info-value" id="infoAadhaar">—</span>
                </div>
            </div>

            <!-- Footer -->
            <div class="card-footer">
                <div class="footer-row">
                    <i class="fas fa-phone-alt"></i>
                    <span id="companyPhone">+91 90360 39555</span>
                </div>
                <div class="footer-row">
                    <i class="fas fa-globe"></i>
                    <span id="companyWeb">www.subramanyahomehealthcare.com</span>
                </div>
            </div>

        </div><!-- /#idCardEl -->
    </div><!-- /.card-wrapper -->

<script>
    var helperId = @helperId;
    var userId   = @(ViewBag.UserId ?? 0);

    // ── Iframe detection: hide page-level chrome when shown inside modal ──
    if (window.self !== window.top) {
        var hdr  = document.querySelector('.page-header');
        var btns = document.querySelector('.action-buttons');
        if (hdr)  hdr.style.display  = 'none';
        if (btns) btns.style.display = 'none';
        document.body.style.padding = '16px';
    }

    function fmtDate(val) {
        if (!val) return null;
        var d = new Date(val);
        if (isNaN(d.getTime())) return null;
        // dd-mm-yyyy (matches reference card format)
        return String(d.getDate()).padStart(2,'0') + '-' +
               String(d.getMonth() + 1).padStart(2,'0') + '-' +
               d.getFullYear();
    }

    function setRow(rowId, infoId, value) {
        if (!value) {
            document.getElementById(rowId).style.display = 'none';
        } else {
            document.getElementById(infoId).textContent = value;
        }
    }

    // ── Fetch helper data ──────────────────────────────────────────
    $.ajax({
        url: '/Helpers/GetHelperById',
        type: 'GET',
        data: { id: helperId, userId: userId },
        success: function (h) {
            if (!h) {
                document.getElementById('loadingOverlay').innerHTML =
                    '<p style="color:red">Helper not found.</p>';
                return;
            }

            // Photo
            var photoEl = document.getElementById('helperPhoto');
            if (h.image) {
                var src = h.image.indexOf('~') !== -1
                    ? 'data:image/png;base64,' + h.image.split('~')[1]
                    : 'data:image/png;base64,' + h.image;
                photoEl.src = src;
                photoEl.onerror = function () { photoEl.replaceWith(makePlaceholder()); };
            } else {
                photoEl.replaceWith(makePlaceholder());
            }

            // Name & Role
            document.getElementById('helperName').textContent = h.name || '—';
            var roleText = (h.designation || 'Helper').toUpperCase();
            document.getElementById('helperRole').textContent = roleText;
            document.getElementById('infoRole').textContent   = h.designation || 'Helper';

            // Info rows
            document.getElementById('infoId').textContent = 'SHHS' + String(h.id).padStart(4, '0');
            setRow('rowDob',    'infoDob',    fmtDate(h.dateOfBirth));
            // Mobile and Aadhar always visible — show '—' when not yet filled
            document.getElementById('infoMobile').textContent  = h.mobileNo  || '—';
            document.getElementById('infoAadhaar').textContent = h.aadhaarNo || '—';

            // Reveal card
            document.getElementById('loadingOverlay').style.display = 'none';
            document.getElementById('idCardEl').style.display       = 'flex';
        },
        error: function () {
            document.getElementById('loadingOverlay').innerHTML =
                '<p style="color:red">Failed to load helper details.</p>';
        }
    });

    // ── Fetch company details (phone / website) ────────────────────
    $.ajax({
        url: '/Configuration/CityDetails',
        type: 'GET',
        data: { username: 'admin' },
        success: function (c) {
            if (!c) return;
            if (c.mobileNumbers) {
                document.getElementById('companyPhone').textContent = c.mobileNumbers;
            }
            if (c.email) {
                document.getElementById('companyWeb').textContent = c.email;
            }
        },
        error: function () { /* silently ignore — fallback text already shown */ }
    });

    function makePlaceholder() {
        var div = document.createElement('div');
        div.className = 'photo-placeholder';
        div.innerHTML = '<i class="fas fa-user"></i>';
        return div;
    }

    // ── Download PDF ────────────────────────────────────────────────
    async function downloadPDF(e) {
        var card = document.getElementById('idCardEl');
        if (!card) return;
        var btn = e ? e.currentTarget : null;
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating…'; }
        try {
            var canvas = await html2canvas(card, {
                scale:           3,
                useCORS:         true,
                allowTaint:      true,
                logging:         false,
                backgroundColor: '#ffffff'
            });
            // Scale to match card's actual proportions at 54 mm wide
            var PDF_W   = 54;
            var PDF_H   = Math.round(card.offsetHeight / card.offsetWidth * PDF_W);
            var jsPDFCtor = (window.jspdf && window.jspdf.jsPDF) || window.jsPDF;
            var doc = new jsPDFCtor({ unit: 'mm', format: [PDF_W, PDF_H], orientation: 'portrait' });
            doc.addImage(canvas.toDataURL('image/jpeg', 0.97), 'JPEG', 0, 0, PDF_W, PDF_H);
            var name = document.getElementById('helperName').textContent.replace(/\s+/g, '_') || 'Helper';
            doc.save('IDCard_' + name + '.pdf');
        } catch (err) {
            alert('PDF generation failed. Please try Print instead.');
        } finally {
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fas fa-file-pdf"></i> Download PDF'; }
        }
    }
</script>
</body>
</html>
