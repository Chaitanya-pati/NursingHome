@{
    ViewData["Title"] = "Attendance";
}
<style>
    @@media (max-width: 767px) {
        #tableAttendance td:nth-child(1)::before { content: "Helper Name"; }
        #tableAttendance td:nth-child(2)::before { content: "Patient Name"; }
        #tableAttendance td:nth-child(3)::before { content: "Check-In Time"; }
        #tableAttendance td:nth-child(4)::before { content: "Status"; }
        #tableAttendance td:nth-child(5)::before { content: "Address"; }
        #tableAttendance td:nth-child(6)::before { content: "Description"; }
        #tableAttendance td:nth-child(7)::before { content: none; }
        #tableAttendance td:nth-child(5),
        #tableAttendance td:nth-child(6) { word-break: break-word; }
    }

    /* Status badge colours */
    .badge-pending  { background-color: #f0ad4e; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 12px; }
    .badge-approved { background-color: #5cb85c; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 12px; }
    .badge-rejected { background-color: #d9534f; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 12px; }

    /* GPS indicator */
    #gpsStatusBox { font-size: 13px; margin-top: 6px; }
    .gps-ok   { color: #27ae60; }
    .gps-wait { color: #e67e22; }
    .gps-err  { color: #e74c3c; }
</style>

<div class="col-md-12">
    @Html.Partial("~/Partialviews/_SearchBar.cshtml")
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12 text-right mb-2 mt-2 page-add-btn">
            <!-- GPS Check-In button (primary action) -->
            <button type="button" class="customBtn mr-2" onclick="OpenCheckInModal()">
                <i class="fa fa-map-marker"></i> Check In
            </button>
            <!-- Keep existing manual Add for admin use -->
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="ClearAttendenceModalData()" data-toggle="modal" data-target="#AddAttendanceModal">
                Add Attendance (Admin)
            </button>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         GPS CHECK-IN MODAL
         ══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="CheckInModal" tabindex="-1" role="dialog" aria-labelledby="CheckInModalLabel" aria-hidden="true" data-backdrop="static">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="CheckInModalLabel">
                        <i class="fa fa-map-marker" style="color:#e74c3c"></i> Employee Check In
                    </h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="ciHelperDDL">Select Helper</label>
                        <select class="form-select" id="ciHelperDDL" required></select>
                    </div>
                    <div class="form-group">
                        <label for="ciPatientDDL">Select Patient</label>
                        <select class="form-select" id="ciPatientDDL" required></select>
                    </div>
                    <div class="form-group">
                        <label for="ciDescription">Description (optional)</label>
                        <textarea class="form-control" id="ciDescription" rows="2"></textarea>
                    </div>

                    <!-- GPS status display -->
                    <div id="gpsStatusBox">
                        <span class="gps-wait"><i class="fa fa-spinner fa-spin"></i> Waiting for GPS location…</span>
                    </div>

                    <!-- Hidden GPS values populated by JS -->
                    <input type="hidden" id="ciLatitude">
                    <input type="hidden" id="ciLongitude">
                    <input type="hidden" id="ciAccuracy">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="btnCheckIn" onclick="SubmitCheckIn()" disabled>
                        <i class="fa fa-map-marker"></i> Check In
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════
         EXISTING ADMIN ADD/EDIT MODAL (unchanged)
         ══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="AddAttendanceModal" tabindex="-1" role="dialog" aria-labelledby="AttendanceModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="AttendanceModalLabel">Attendance Form</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="attendanceForm" novalidate>
                        <div class="form-group">
                            <label for="HelperName">Select Helper</label>
                            <select class="form-select ClearAttendenceClass" id="HelperNameDDL" required></select>
                            <div class="invalid-feedback ClearAttendenceClass">Please select the Helper</div>
                        </div>
                        <div class="form-group">
                            <label for="PatientName">Select Patient</label>
                            <select class="form-select ClearAttendenceClass" id="PatientNameDDL" required></select>
                            <div class="invalid-feedback ClearAttendenceClass">Please select the Patient</div>
                        </div>
                        <div class="form-group">
                            <label for="AttendanceDate">Select Date</label>
                            <input type="datetime-local" class="form-control ClearAttendenceClass" id="AttendanceDate" required>
                            <div class="invalid-feedback ClearAttendenceClass">Please select the date</div>
                        </div>
                        <div class="form-group">
                            <label for="TotalHours">Total Work Hours</label>
                            <input type="text" class="form-control ClearAttendenceClass" id="TotalHours">
                        </div>
                        <div class="form-group">
                            <label for="Description">Enter Description</label>
                            <textarea class="form-control ClearAttendenceClass" id="Description" rows="4"></textarea>
                        </div>
                        <input type="hidden" class="ClearAttendenceClass" id="AttendanceId">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="AddandEditAttendence()" id="SaveAttendanceData">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Table -->
    <div class="row mt-2">
        <div class="col-md-12">
            <table id="tableAttendance" class="display table-bordered rct-table" style="width:100%">
                <thead class="thead-light">
                    <tr>
                        <th>Helper Name</th>
                        <th>Patient Name</th>
                        <th>Check-In Time</th>
                        <th>Status</th>
                        <th>Address</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#tableAttendance').DataTable();
        GetAttendanceData();
        HelpersDropDownList();
        PatientDropDownList();
        HelpersDropDownList1();

        $('#tableAttendance').on('click', '.btn-edit', function () {
            var fullData = JSON.parse($(this).attr('data-full-data'));
            BindAttendanceData(fullData);
        });

        $('#tableAttendance').on('click', '.btn-delete', function () {
            var ID = $(this).attr('data-id');
            confirmDelete(ID);
        });

        $('#search').on('click', function () { });
    });

    // ──────────────────────────────────────────────────────────────────────────
    // GPS CHECK-IN
    // ──────────────────────────────────────────────────────────────────────────

    var _gpsWatchId = null;

    function OpenCheckInModal() {
        // Reset state
        $('#ciLatitude').val('');
        $('#ciLongitude').val('');
        $('#ciAccuracy').val('');
        $('#ciDescription').val('');
        $('#btnCheckIn').prop('disabled', true);
        SetGpsStatus('wait', '<i class="fa fa-spinner fa-spin"></i> Acquiring GPS location…');

        // Populate dropdowns for check-in modal
        PopulateCheckInDropdowns();

        $('#CheckInModal').modal('show');

        // Start watching position
        if (!navigator.geolocation) {
            SetGpsStatus('err', '<i class="fa fa-times-circle"></i> GPS is not supported on this device or browser.');
            return;
        }

        _gpsWatchId = navigator.geolocation.getCurrentPosition(
            function (pos) {
                var lat = pos.coords.latitude.toFixed(6);
                var lon = pos.coords.longitude.toFixed(6);
                var acc = pos.coords.accuracy.toFixed(1);
                $('#ciLatitude').val(lat);
                $('#ciLongitude').val(lon);
                $('#ciAccuracy').val(acc);
                SetGpsStatus('ok',
                    '<i class="fa fa-check-circle"></i> Location captured &mdash; accuracy <strong>' +
                    acc + ' m</strong>. Ready to check in.');
                $('#btnCheckIn').prop('disabled', false);
            },
            function (err) {
                var msg = {
                    1: 'Location permission denied. Please allow location access and try again.',
                    2: 'Location unavailable. Check your device GPS.',
                    3: 'GPS timed out. Move to an open area and try again.'
                }[err.code] || 'Unknown GPS error.';
                SetGpsStatus('err', '<i class="fa fa-times-circle"></i> ' + msg);
            },
            { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
        );

        // Clean up watch when modal closes
        $('#CheckInModal').one('hidden.bs.modal', function () {
            if (_gpsWatchId !== null) {
                navigator.geolocation.clearWatch(_gpsWatchId);
                _gpsWatchId = null;
            }
        });
    }

    function SetGpsStatus(type, html) {
        var cls = { ok: 'gps-ok', wait: 'gps-wait', err: 'gps-err' }[type] || 'gps-wait';
        $('#gpsStatusBox').html('<span class="' + cls + '">' + html + '</span>');
    }

    function SubmitCheckIn() {
        var helperId  = $('#ciHelperDDL').val();
        var patientId = $('#ciPatientDDL').val();
        var lat       = $('#ciLatitude').val();
        var lon       = $('#ciLongitude').val();
        var acc       = $('#ciAccuracy').val();
        var desc      = $('#ciDescription').val();

        if (!helperId || !patientId) {
            alert('Please select a Helper and a Patient before checking in.');
            return;
        }
        if (!lat || !lon) {
            alert('GPS location has not been captured yet. Please wait.');
            return;
        }

        $('#btnCheckIn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Checking in…');

        $.ajax({
            url: '/Attendance/CheckIn',
            type: 'POST',
            data: {
                fkHelperId:  helperId,
                fkNursingId: patientId,
                latitude:    lat,
                longitude:   lon,
                gpsAccuracy: acc,
                description: desc
            },
            success: function (res) {
                $('#CheckInModal').modal('hide');
                GetAttendanceData();
                Swal.fire({
                    icon:  'success',
                    title: 'Checked In!',
                    html:  '<b>' + res.checkInTime + '</b><br><small>' + res.address + '</small><br>' +
                           '<span class="badge-pending" style="display:inline-block;margin-top:6px">' + res.status + '</span>'
                });
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message)
                    ? xhr.responseJSON.message
                    : 'An error occurred during check-in.';
                Swal.fire({ icon: 'error', title: 'Check-In Failed', text: msg });
                $('#btnCheckIn').prop('disabled', false).html('<i class="fa fa-map-marker"></i> Check In');
            }
        });
    }

    function PopulateCheckInDropdowns() {
        // Helper dropdown for Check-In modal
        $.ajax({
            url: '/Attendance/GetHelpers', type: 'GET',
            success: function (res) {
                var ddl = $('#ciHelperDDL').empty().append('<option value="">Select Helper</option>');
                $.each(res.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.name }));
                });
            }
        });
        // Patient dropdown for Check-In modal
        $.ajax({
            url: '/Attendance/GetPatientDetails', type: 'GET',
            success: function (res) {
                var ddl = $('#ciPatientDDL').empty().append('<option value="">Select Patient</option>');
                $.each(res.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.patientName }));
                });
            }
        });
    }

    // ──────────────────────────────────────────────────────────────────────────
    // EXISTING ADMIN FUNCTIONS (unchanged)
    // ──────────────────────────────────────────────────────────────────────────

    function GetAttendencehelper() { }

    function AddandEditAttendence() {
        var helperName    = $('#HelperNameDDL').val();
        var patientName   = $('#PatientNameDDL').val();
        var attendanceDate = $('#AttendanceDate').val();
        var totalHours    = $('#TotalHours').val();
        var description   = $('#Description').val();
        var attendanceId  = $('#AttendanceId').val();

        $.ajax({
            url: '/Attendance/AddandUpdateAttendance',
            type: 'POST',
            data: {
                fkHelperId:  helperName,
                fkNursingId: patientName,
                Date:        attendanceDate,
                Time:        totalHours,
                Description: description,
                Id:          attendanceId
            },
            success: function (response) {
                if (response) {
                    GetAttendanceData();
                    if (attendanceId == null || attendanceId == 0)
                        alert('Success: data added successfully');
                    else
                        alert('Success: data updated successfully');
                    $('#AddAttendanceModal').modal('hide');
                }
            },
            error: function (xhr, status, error) {
                alert('An error occurred: ' + error);
            }
        });
    }

    function confirmDelete(id) {
        $.confirm({
            title: 'Confirm',
            content: 'Are you sure you want to delete this record?',
            buttons: {
                Yes: {
                    btnClass: 'btn btn-success',
                    action: function () { deleteAttendance(id); }
                },
                No: {
                    btnClass: 'btn btn-warning',
                    action: function () { }
                }
            }
        });
    }

    function BindAttendanceData(data) {
        $('#HelperNameDDL').val(data.fkHelperId);
        $('#PatientNameDDL').val(data.fknursing);
        $('#AttendanceDate').val(data.attendanceDate);
        $('#TotalHours').val(data.time);
        $('#Description').val(data.description);
        $('#AttendanceId').val(data.attendanceId);
        $('#AddAttendanceModal').modal('show');
    }

    function deleteAttendance(id) {
        $.ajax({
            type: 'POST',
            url: '/Attendance/DeleteAttendence',
            data: { id: id },
            success: function () {
                GetAttendanceData();
                alert('Record deleted successfully');
            },
            error: function () {
                alert('Error occurred deleting record');
            }
        });
    }

    function statusBadge(status) {
        if (!status) return '<span class="text-muted">—</span>';
        if (status === 'Approved')        return '<span class="badge-approved">' + status + '</span>';
        if (status === 'Rejected')        return '<span class="badge-rejected">' + status + '</span>';
        if (status === 'Pending Approval') return '<span class="badge-pending">'  + status + '</span>';
        return '<span>' + status + '</span>';
    }

    function formatCheckInTime(item) {
        // Prefer CheckInTime (GPS records); fall back to Date for old records
        if (item.checkInTime) {
            var d = new Date(item.checkInTime);
            return isNaN(d) ? item.checkInTime : d.toLocaleString();
        }
        if (item.attendanceDate) return item.attendanceDate;
        return '—';
    }

    function GetAttendanceData() {
        var table = $('#tableAttendance').DataTable();

        $.ajax({
            type: 'POST',
            url: '/Attendance/GetAttendanceData',
            success: function (response) {
                table.clear();
                response.data.forEach(function (item) {
                    table.row.add([
                        item.helperName  || '—',
                        item.patientName || '—',
                        formatCheckInTime(item),
                        statusBadge(item.status),
                        item.address     || '—',
                        item.description || '—',
                        '<div class="text-center">' +
                            '<i class="fa fa-edit me-4 btn-edit" style="color:green;cursor:pointer" ' +
                                'data-full-data=\'' + JSON.stringify(item).replace(/'/g, "&#39;") + '\'></i> ' +
                            '<i class="fa fa-trash btn-delete" style="color:red;cursor:pointer" ' +
                                'data-id="' + item.attendanceId + '"></i>' +
                        '</div>'
                    ]).draw();
                });
            },
            error: function (xhr, status, error) {
                alert('An error occurred: ' + error);
            }
        });
    }

    function PatientDropDownList() {
        $.ajax({
            url: '/Attendance/GetPatientDetails', type: 'GET',
            success: function (response) {
                var ddl = $('#PatientNameDDL').empty()
                    .append($('<option>', { value: '', text: 'Select Patient', selected: true }));
                $.each(response.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.patientName }));
                });
            },
            error: function (xhr, status, error) {
                console.error("Error fetching Patient Details:", error);
            }
        });
    }

    function HelpersDropDownList() {
        $.ajax({
            url: '/Attendance/GetHelpers', type: 'GET',
            success: function (response) {
                var ddl = $('#HelperNameDDL').empty()
                    .append($('<option>', { value: '', text: 'Select Helper', selected: true }));
                $.each(response.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.name }));
                });
            },
            error: function (xhr, status, error) {
                console.error("Error fetching Helpers Details:", error);
            }
        });
    }

    function HelpersDropDownList1() {
        $.ajax({
            url: '/Attendance/GetHelpers', type: 'GET',
            success: function (response) {
                var ddl = $('#ddlHelper').empty()
                    .append($('<option>', { value: '', text: 'Select Helper', selected: true }));
                $.each(response.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.name }));
                });
            },
            error: function (xhr, status, error) {
                console.error("Error fetching Helpers Details:", error);
            }
        });
    }

    function ClearAttendenceModalData() {
        $('.ClearAttendenceClass').val('');
    }
</script>
