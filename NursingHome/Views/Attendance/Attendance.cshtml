@{
    ViewData["Title"] = "Attendance";
}
<style>
    /* ── Mobile card labels ─────────────────────────────────── */
    @@media (max-width: 767px) {
        #tableAttendance td:nth-child(1)::before { content: "Helper Name"; }
        #tableAttendance td:nth-child(2)::before { content: "Patient Name"; }
        #tableAttendance td:nth-child(3)::before { content: "Check-In Time"; }
        #tableAttendance td:nth-child(4)::before { content: "Check-Out Time"; }
        #tableAttendance td:nth-child(5)::before { content: "Total Hrs"; }
        #tableAttendance td:nth-child(6)::before { content: "Status"; }
        #tableAttendance td:nth-child(7)::before { content: "Check-In Address"; }
        #tableAttendance td:nth-child(8)::before { content: none; }

        #tablePending td:nth-child(1)::before { content: "Helper"; }
        #tablePending td:nth-child(2)::before { content: "Patient"; }
        #tablePending td:nth-child(3)::before { content: "Date"; }
        #tablePending td:nth-child(4)::before { content: "Check-In"; }
        #tablePending td:nth-child(5)::before { content: "Check-Out"; }
        #tablePending td:nth-child(6)::before { content: "Est. Hours"; }
        #tablePending td:nth-child(7)::before { content: none; }

        #tableAttendance td:nth-child(7),
        #tableAttendance td:nth-child(3),
        #tableAttendance td:nth-child(4) { word-break: break-word; }
    }

    /* ── Status badges ──────────────────────────────────────── */
    .badge-pending  { background-color: #f0ad4e; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 12px; }
    .badge-approved { background-color: #5cb85c; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 12px; }
    .badge-rejected { background-color: #d9534f; color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 12px; }

    /* ── GPS indicator ──────────────────────────────────────── */
    .gps-status-box { font-size: 13px; margin-top: 6px; }
    .gps-ok   { color: #27ae60; }
    .gps-wait { color: #e67e22; }
    .gps-err  { color: #e74c3c; }

    /* ── Approval modal detail grid ─────────────────────────── */
    .approval-detail-row { display: flex; gap: 12px; margin-bottom: 8px; }
    .approval-detail-row .detail-label  { font-weight: 600; min-width: 130px; color: #555; font-size: 13px; }
    .approval-detail-row .detail-value  { font-size: 13px; word-break: break-word; }
    .approval-section-header { font-weight: 700; font-size: 13px; text-transform: uppercase;
                                letter-spacing: .5px; color: #6750a4; margin: 10px 0 4px; border-bottom: 1px solid #ddd; }
    /* ── Pending badge on tab ───────────────────────────────── */
    #pendingCountBadge { font-size: 11px; padding: 2px 6px; }
</style>

<!-- ═══════════════════════════════════════════════════════════════
     GPS CHECK-IN MODAL
     ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="CheckInModal" tabindex="-1" role="dialog" aria-labelledby="CheckInModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CheckInModalLabel">
                    <i class="fa fa-map-marker" style="color:#e74c3c"></i> Employee Check In
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group" id="ciHelperGroup">
                    <label for="ciHelperDDL">Select Helper</label>
                    <select class="form-select" id="ciHelperDDL" required></select>
                </div>
                <div class="form-group">
                    <label for="ciPatientDDL">Select Patient</label>
                    <select class="form-select" id="ciPatientDDL" required></select>
                </div>
                <div class="form-group">
                    <label for="ciDescription">Description (optional)</label>
                    <textarea class="form-control" id="ciDescription" rows="2"></textarea>
                </div>
                <div class="gps-status-box" id="ciGpsStatusBox">
                    <span class="gps-wait"><i class="fa fa-spinner fa-spin"></i> Waiting for GPS location…</span>
                </div>
                <input type="hidden" id="ciLatitude">
                <input type="hidden" id="ciLongitude">
                <input type="hidden" id="ciAccuracy">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnCheckIn" onclick="SubmitCheckIn()" disabled>
                    <i class="fa fa-map-marker"></i> Check In
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     GPS CHECK-OUT MODAL
     ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="CheckOutModal" tabindex="-1" role="dialog" aria-labelledby="CheckOutModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="CheckOutModalLabel">
                    <i class="fa fa-sign-out-alt" style="color:#27ae60"></i> Employee Check Out
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="coRecordInfo" class="alert alert-info" style="font-size:13px;padding:8px 12px;margin-bottom:12px;"></div>
                <div class="gps-status-box" id="coGpsStatusBox">
                    <span class="gps-wait"><i class="fa fa-spinner fa-spin"></i> Acquiring GPS location…</span>
                </div>
                <input type="hidden" id="coAttendanceId">
                <input type="hidden" id="coLatitude">
                <input type="hidden" id="coLongitude">
                <input type="hidden" id="coAccuracy">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnCheckOut" onclick="SubmitCheckOut()" disabled>
                    <i class="fa fa-sign-out-alt"></i> Check Out
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     APPROVE / REJECT DETAIL MODAL
     ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="ApprovalModal" tabindex="-1" role="dialog" aria-labelledby="ApprovalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" id="approvalModalHeader">
                <h5 class="modal-title" id="ApprovalModalLabel">Review Attendance</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="max-height:65vh;overflow-y:auto">

                <!-- Employee summary -->
                <div class="approval-section-header">Employee &amp; Shift</div>
                <div class="approval-detail-row">
                    <span class="detail-label">Employee</span>
                    <span class="detail-value" id="amHelperName">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">Patient</span>
                    <span class="detail-value" id="amPatientName">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">Date</span>
                    <span class="detail-value" id="amDate">—</span>
                </div>

                <!-- Times & hours -->
                <div class="approval-section-header">Times &amp; Duration</div>
                <div class="approval-detail-row">
                    <span class="detail-label">Check-In Time</span>
                    <span class="detail-value" id="amCheckInTime">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">Check-Out Time</span>
                    <span class="detail-value" id="amCheckOutTime">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">Total Hours</span>
                    <span class="detail-value" id="amTotalHours">—</span>
                </div>

                <!-- Check-In GPS -->
                <div class="approval-section-header">Check-In Location</div>
                <div class="approval-detail-row">
                    <span class="detail-label">Address</span>
                    <span class="detail-value" id="amCheckInAddress">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">Latitude / Longitude</span>
                    <span class="detail-value" id="amCheckInLatLon">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">GPS Accuracy</span>
                    <span class="detail-value" id="amCheckInAccuracy">—</span>
                </div>

                <!-- Check-Out GPS -->
                <div class="approval-section-header">Check-Out Location</div>
                <div class="approval-detail-row">
                    <span class="detail-label">Address</span>
                    <span class="detail-value" id="amCheckOutAddress">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">Latitude / Longitude</span>
                    <span class="detail-value" id="amCheckOutLatLon">—</span>
                </div>
                <div class="approval-detail-row">
                    <span class="detail-label">GPS Accuracy</span>
                    <span class="detail-value" id="amCheckOutAccuracy">—</span>
                </div>

                <!-- Remarks -->
                <div class="approval-section-header">Manager Remarks (optional)</div>
                <textarea class="form-control" id="amRemarks" rows="3" placeholder="Enter remarks…"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn" id="btnConfirmApproval" onclick="SubmitApproval()">Confirm</button>
            </div>
            <input type="hidden" id="amAttendanceId">
            <input type="hidden" id="amAction">
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     PAGE CONTENT
     ═══════════════════════════════════════════════════════════════ -->
<div class="col-md-12">
    @Html.Partial("~/Partialviews/_SearchBar.cshtml")
</div>

<div class="container-fluid">

    <!-- Tab navigation -->
    <ul class="nav nav-tabs mt-2" id="attendanceTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" id="recordsTabLink" data-toggle="tab"
               href="#recordsTabContent" role="tab">
                <i class="fa fa-list me-1"></i> Attendance Records
            </a>
        </li>
        <li class="nav-item AuthorizedContent" hidden id="liPendingTab">
            <a class="nav-link" id="pendingTabLink" data-toggle="tab"
               href="#pendingTabContent" role="tab" onclick="GetPendingData()">
                <i class="fa fa-clock me-1"></i> Pending Approvals
                <span class="badge badge-warning ml-1" id="pendingCountBadge" hidden></span>
            </a>
        </li>
    </ul>


    <div class="tab-content mt-2" id="attendanceTabsContent">

        <!-- ── Tab 1: Attendance Records ──────────────────────────── -->
        <div class="tab-pane fade show active" id="recordsTabContent" role="tabpanel">

            <div class="row mb-2 mt-1 page-add-btn">
                <div class="col-md-12 text-right">
                    <button type="button" class="customBtn mr-2" onclick="OpenCheckInModal()">
                        <i class="fa fa-map-marker"></i> Check In
                    </button>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table id="tableAttendance" class="display table-bordered rct-table" style="width:100%">
                            <thead class="thead-light">
                                <tr>
                                    <th>Helper Name</th>
                                    <th>Patient Name</th>
                                    <th>Check-In Time</th>
                                    <th>Check-Out Time</th>
                                    <th>Total Hrs</th>
                                    <th>Status</th>
                                    <th>Check-In Address</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Tab 2: Pending Approvals (admin only) ──────────────── -->
        <div class="tab-pane fade" id="pendingTabContent" role="tabpanel">
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive">
                        <table id="tablePending" class="display table-bordered rct-table" style="width:100%">
                            <thead class="thead-light">
                                <tr>
                                    <th>Helper Name</th>
                                    <th>Patient Name</th>
                                    <th>Date</th>
                                    <th>Check-In Time</th>
                                    <th>Check-Out Time</th>
                                    <th>Est. Hours</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /tab-content -->
</div><!-- /container-fluid -->

<script>
    // ────────────────────────────────────────────────────────────────────────────
    // Pending pre-select values — set by BindAttendanceData when dropdowns not yet loaded
    // ────────────────────────────────────────────────────────────────────────────

    // ────────────────────────────────────────────────────────────────────────────
    // Init
    // ────────────────────────────────────────────────────────────────────────────
    $(document).ready(function () {
        $('#tableAttendance').DataTable({ order: [[2, 'desc']] });
        $('#tablePending').DataTable({ order: [[3, 'desc']] });

        GetAttendanceData();
        HelpersDropDownList1();

        // Search button — apply date range + helper filter
        $('#search').on('click', function () {
            var start        = $('#startDate').val()  || null;
            var end          = $('#endDate').val()    || null;
            var helperId     = $('#ddlHelper').val()  || null;
            GetAttendanceData(start, end, helperId);
        });

        // Role-based UI is driven by the layout's AuthorizedContent mechanism.
        // Poll briefly for the role (set async by layout via AJAX) then update.
        var role = localStorage.getItem('userRole');
        if (role === 'admin') {
            LoadPendingCount();
        } else {
            // Role may not be in localStorage yet (first load); retry once after layout sets it
            setTimeout(function () {
                if (localStorage.getItem('userRole') === 'admin') LoadPendingCount();
            }, 1500);
        }

        // Delete click handler on main table
        $('#tableAttendance').on('click', '.btn-delete', function () {
            var ID = $(this).attr('data-id');
            confirmDelete(ID);
        });

        // Approve / Reject via delegated handlers — avoids inline-JSON onclick breakage
        $('#tablePending').on('click', '.btn-approve', function () {
            var item = JSON.parse($(this).attr('data-record'));
            OpenApprovalModal(item, 'approve');
        });
        $('#tablePending').on('click', '.btn-reject', function () {
            var item = JSON.parse($(this).attr('data-record'));
            OpenApprovalModal(item, 'reject');
        });
    });

    // ────────────────────────────────────────────────────────────────────────────
    // HELPER UTILITIES
    // ────────────────────────────────────────────────────────────────────────────

    function fmtDateTime(val) {
        if (!val) return '—';
        var d = new Date(val);
        return isNaN(d.getTime()) ? val : d.toLocaleString();
    }

    function fmtDate(val) {
        if (!val) return '—';
        var d = new Date(val);
        return isNaN(d.getTime()) ? val : d.toLocaleDateString();
    }

    function calcHours(checkIn, checkOut) {
        if (!checkIn || !checkOut) return null;
        var ci = new Date(checkIn), co = new Date(checkOut);
        if (isNaN(ci) || isNaN(co)) return null;
        return Math.round((co - ci) / 36000) / 100;   // 2-decimal hours
    }

    function statusBadge(status) {
        if (!status) return '<span class="text-muted">—</span>';
        if (status === 'Approved')         return '<span class="badge-approved">' + status + '</span>';
        if (status === 'Rejected')         return '<span class="badge-rejected">' + status + '</span>';
        if (status === 'Pending Approval') return '<span class="badge-pending">'  + status + '</span>';
        return '<span>' + status + '</span>';
    }

    function setGpsStatus(boxId, type, html) {
        var cls = { ok: 'gps-ok', wait: 'gps-wait', err: 'gps-err' }[type] || 'gps-wait';
        $('#' + boxId).html('<span class="' + cls + '">' + html + '</span>');
    }

    // ────────────────────────────────────────────────────────────────────────────
    // GPS CHECK-IN
    // ────────────────────────────────────────────────────────────────────────────
    function OpenCheckInModal() {
        $('#ciLatitude').val('');
        $('#ciLongitude').val('');
        $('#ciAccuracy').val('');
        $('#ciDescription').val('');
        $('#btnCheckIn').prop('disabled', true);
        setGpsStatus('ciGpsStatusBox', 'wait', '<i class="fa fa-spinner fa-spin"></i> Acquiring GPS location…');
        PopulateCheckInDropdowns();
        $('#CheckInModal').modal('show');

        if (!navigator.geolocation) {
            setGpsStatus('ciGpsStatusBox', 'err', '<i class="fa fa-times-circle"></i> GPS not supported on this device.');
            return;
        }

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                var lat = pos.coords.latitude.toFixed(6);
                var lon = pos.coords.longitude.toFixed(6);
                var acc = pos.coords.accuracy.toFixed(1);
                $('#ciLatitude').val(lat);
                $('#ciLongitude').val(lon);
                $('#ciAccuracy').val(acc);
                setGpsStatus('ciGpsStatusBox', 'ok',
                    '<i class="fa fa-check-circle"></i> Location captured — accuracy <strong>' +
                    acc + ' m</strong>. Ready to check in.');
                $('#btnCheckIn').prop('disabled', false);
                console.log('[CheckIn] GPS captured — lat:', lat, 'lon:', lon, 'accuracy:', acc + 'm');
            },
            function (err) {
                var msgs = {
                    1: 'Location permission denied. Please allow location access and try again.',
                    2: 'Location unavailable. Check your device GPS.',
                    3: 'GPS timed out. Move to an open area and try again.'
                };
                setGpsStatus('ciGpsStatusBox', 'err',
                    '<i class="fa fa-times-circle"></i> ' + (msgs[err.code] || 'Unknown GPS error.'));
                console.error('[CheckIn] GPS error code:', err.code, err.message);
            },
            { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
        );
    }

    function SubmitCheckIn() {
        var helperId  = $('#ciHelperDDL').val();
        var patientId = $('#ciPatientDDL').val();
        var lat       = $('#ciLatitude').val();
        var lon       = $('#ciLongitude').val();
        var acc       = $('#ciAccuracy').val();
        var desc      = $('#ciDescription').val();

        if (!helperId || !patientId) {
            alert('Please select a Helper and a Patient before checking in.');
            return;
        }
        if (!lat || !lon) {
            alert('GPS location has not been captured yet. Please wait.');
            return;
        }

        console.log('[CheckIn] Submitting — helperId:', helperId,
                    'patientId:', patientId, 'lat:', lat, 'lon:', lon, 'acc:', acc);

        $('#btnCheckIn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Checking in…');

        $.ajax({
            url: '/Attendance/CheckIn',
            type: 'POST',
            data: { fkHelperId: helperId, fkNursingId: patientId,
                    latitude: lat, longitude: lon, gpsAccuracy: acc, description: desc },
            success: function (res) {
                console.log('[CheckIn] Success:', res);
                $('#CheckInModal').modal('hide');
                GetAttendanceData();
                if (localStorage.getItem('userRole') === 'admin') LoadPendingCount();
                Swal.fire({
                    icon: 'success', title: 'Checked In!',
                    html: '<b>' + res.checkInTime + '</b><br><small>' + res.address + '</small><br>' +
                          '<span class="badge-pending" style="display:inline-block;margin-top:6px">' + res.status + '</span>'
                });
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message)
                    ? xhr.responseJSON.message : 'An error occurred during check-in.';
                console.error('[CheckIn] Error:', xhr.status, msg);
                Swal.fire({ icon: 'error', title: 'Check-In Failed', text: msg });
                $('#btnCheckIn').prop('disabled', false)
                                .html('<i class="fa fa-map-marker"></i> Check In');
            }
        });
    }

    function LoadPatientsByHelper(helperId) {
        var url = '/Attendance/GetPatientDetails';
        if (helperId) url += '?helperId=' + helperId;
        $.ajax({
            url: url, type: 'GET',
            success: function (res) {
                var ddl = $('#ciPatientDDL').empty().append('<option value="">Select Patient</option>');
                $.each(res.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.patientName }));
                });
            }
        });
    }

    function PopulateCheckInDropdowns() {
        // Server resolves identity from session — no userId needed in the request.
        $.ajax({ url: '/Attendance/GetHelpers', type: 'GET',
            success: function (res) {
                var ddl = $('#ciHelperDDL').empty();
                $.each(res.data, function (i, item) { ddl.append($('<option>', { value: item.id, text: item.name })); });

                if (!res.isAdmin && res.data.length === 1) {
                    // Non-admin with an assigned helper — auto-select and hide the field
                    ddl.val(res.data[0].id);
                    $('#ciHelperGroup').hide();
                    // Load only this helper's patients
                    LoadPatientsByHelper(res.data[0].id);
                } else {
                    // Admin (or unassigned non-admin): show the dropdown with a placeholder
                    ddl.prepend('<option value="">Select Helper</option>').val('');
                    $('#ciHelperGroup').show();
                    // No helper selected yet — load all patients
                    LoadPatientsByHelper(null);
                }
            }
        });

        // When admin changes the helper selection, refresh the patient list
        $('#ciHelperDDL').off('change.checkin').on('change.checkin', function () {
            var selectedHelper = $(this).val();
            LoadPatientsByHelper(selectedHelper || null);
        });
    }

    // ────────────────────────────────────────────────────────────────────────────
    // GPS CHECK-OUT
    // ────────────────────────────────────────────────────────────────────────────
    function OpenCheckOutModal(attendanceId, helperName, patientName) {
        $('#coAttendanceId').val(attendanceId);
        $('#coLatitude').val('');
        $('#coLongitude').val('');
        $('#coAccuracy').val('');
        $('#btnCheckOut').prop('disabled', true);
        $('#coRecordInfo').html(
            '<i class="fa fa-user me-1"></i><strong>' + helperName + '</strong>' +
            ' &rarr; ' + patientName
        );
        setGpsStatus('coGpsStatusBox', 'wait',
            '<i class="fa fa-spinner fa-spin"></i> Acquiring GPS location…');
        $('#CheckOutModal').modal('show');

        if (!navigator.geolocation) {
            setGpsStatus('coGpsStatusBox', 'err',
                '<i class="fa fa-times-circle"></i> GPS not supported on this device.');
            return;
        }

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                var lat = pos.coords.latitude.toFixed(6);
                var lon = pos.coords.longitude.toFixed(6);
                var acc = pos.coords.accuracy.toFixed(1);
                $('#coLatitude').val(lat);
                $('#coLongitude').val(lon);
                $('#coAccuracy').val(acc);
                setGpsStatus('coGpsStatusBox', 'ok',
                    '<i class="fa fa-check-circle"></i> Location captured — accuracy <strong>' +
                    acc + ' m</strong>. Ready to check out.');
                $('#btnCheckOut').prop('disabled', false);
                console.log('[CheckOut] GPS captured — lat:', lat, 'lon:', lon, 'accuracy:', acc + 'm');
            },
            function (err) {
                var msgs = {
                    1: 'Location permission denied. Please allow location access and try again.',
                    2: 'Location unavailable. Check your device GPS.',
                    3: 'GPS timed out. Move to an open area and try again.'
                };
                setGpsStatus('coGpsStatusBox', 'err',
                    '<i class="fa fa-times-circle"></i> ' + (msgs[err.code] || 'Unknown GPS error.'));
                console.error('[CheckOut] GPS error code:', err.code, err.message);
            },
            { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
        );
    }

    function SubmitCheckOut() {
        var attendanceId = $('#coAttendanceId').val();
        var lat          = $('#coLatitude').val();
        var lon          = $('#coLongitude').val();
        var acc          = $('#coAccuracy').val();

        if (!lat || !lon) {
            alert('GPS location has not been captured yet. Please wait.');
            return;
        }

        console.log('[CheckOut] Submitting — attendanceId:', attendanceId,
                    'lat:', lat, 'lon:', lon, 'acc:', acc);

        $('#btnCheckOut').prop('disabled', true)
                         .html('<i class="fa fa-spinner fa-spin"></i> Checking out…');

        $.ajax({
            url: '/Attendance/CheckOut',
            type: 'POST',
            data: { attendanceId: attendanceId, latitude: lat, longitude: lon, gpsAccuracy: acc },
            success: function (res) {
                console.log('[CheckOut] Success:', res);
                $('#CheckOutModal').modal('hide');
                GetAttendanceData();
                if (localStorage.getItem('userRole') === 'admin') LoadPendingCount();
                Swal.fire({
                    icon: 'success', title: 'Checked Out!',
                    html: '<b>' + res.checkOutTime + '</b><br>' +
                          '<small>' + res.address + '</small><br>' +
                          '<span class="badge-pending" style="display:inline-block;margin-top:6px">' +
                          'Pending Approval</span>'
                });
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message)
                    ? xhr.responseJSON.message : 'An error occurred during check-out.';
                console.error('[CheckOut] Error:', xhr.status, msg);
                Swal.fire({ icon: 'error', title: 'Check-Out Failed', text: msg });
                $('#btnCheckOut').prop('disabled', false)
                                 .html('<i class="fa fa-sign-out-alt"></i> Check Out');
            }
        });
    }

    // ────────────────────────────────────────────────────────────────────────────
    // MAIN ATTENDANCE TABLE
    // ────────────────────────────────────────────────────────────────────────────
    function GetAttendanceData(startDate, endDate, filterHelperId) {
        var table  = $('#tableAttendance').DataTable();
        var userId = parseInt(localStorage.getItem('userID') || '0', 10);

        var params = { userId: userId };
        if (startDate)      params.startDate     = startDate;
        if (endDate)        params.endDate       = endDate;
        if (filterHelperId) params.filterHelperId = filterHelperId;

        $.ajax({
            type: 'GET', url: '/Attendance/GetAttendanceData',
            data: params,
            success: function (response) {
                console.log('[Attendance] GetAttendanceData — records:', response.data.length);
                table.clear();
                response.data.forEach(function (item) {
                    var checkInDisplay  = item.checkInTime  ? fmtDateTime(item.checkInTime)  : (item.attendanceDate || '—');
                    var checkOutDisplay = item.checkOutTime ? fmtDateTime(item.checkOutTime) : '—';

                    // Total hours: use approved value, or estimate if both times available
                    var totalHrsDisplay;
                    if (item.totalHours != null) {
                        totalHrsDisplay = item.totalHours + ' hrs';
                    } else {
                        var est = calcHours(item.checkInTime, item.checkOutTime);
                        totalHrsDisplay = est !== null ? '<em style="color:#aaa">' + est + ' hrs*</em>' : '—';
                    }

                    // Action buttons
                    var role    = localStorage.getItem('userRole');
                    var isAdmin = (role === 'admin');
                    var actions = '<div class="text-center" style="white-space:nowrap">';

                    // Check-Out button: show only when checked in but not yet out
                    if (item.checkInTime && !item.checkOutTime && item.status === 'Pending Approval') {
                        actions += '<button class="btn btn-sm btn-success mr-1" style="font-size:11px" ' +
                            'onclick="OpenCheckOutModal(' + item.attendanceId + ',' +
                            '\'' + escJs(item.helperName) + '\',\'' + escJs(item.patientName) + '\')">' +
                            '<i class="fa fa-sign-out-alt"></i> Check Out</button>';
                    }

                    // Admin-only: Delete
                    if (isAdmin) {
                        actions += '<button class="btn btn-sm btn-danger btn-delete" style="font-size:11px" ' +
                            'data-id="' + item.attendanceId + '" title="Delete"><i class="fa fa-trash"></i></button>';
                    }

                    actions += '</div>';

                    var labels = ['Helper Name','Patient Name','Check-In Time','Check-Out Time','Total Hrs','Status','Check-In Address',''];
                    var cells  = [
                        item.helperName  || '—',
                        item.patientName || '—',
                        checkInDisplay,
                        checkOutDisplay,
                        totalHrsDisplay,
                        statusBadge(item.status),
                        (item.address    || '—'),
                        actions
                    ];
                    var row = table.row.add(cells).draw();
                    // Set data-label on each td for mobile card view
                    $(row.node()).find('td').each(function (i) {
                        if (labels[i]) $(this).attr('data-label', labels[i]);
                    });
                });
            },
            error: function (xhr, status, error) {
                console.error('[Attendance] GetAttendanceData error:', error);
            }
        });
    }

    // ────────────────────────────────────────────────────────────────────────────
    // PENDING APPROVALS TABLE
    // ────────────────────────────────────────────────────────────────────────────
    function GetPendingData() {
        var table  = $('#tablePending').DataTable();

        $.ajax({
            url: '/Attendance/GetPendingAttendance', type: 'GET',
            success: function (response) {
                console.log('[Attendance] GetPendingAttendance — records:', response.data.length);
                table.clear();
                response.data.forEach(function (item) {
                    var est = calcHours(item.checkInTime, item.checkOutTime);
                    var estDisplay = est !== null ? est + ' hrs' : '—';

                    // Store the full record as a data attribute — avoids inline-JSON
                    // onclick which breaks when names/addresses contain quotes or backslashes.
                    var safeRecord = JSON.stringify(item).replace(/'/g, "&#39;");
                    var actions =
                        '<div class="text-center" style="white-space:nowrap">' +
                        '<button class="btn btn-sm btn-success btn-approve mr-1" style="font-size:11px" ' +
                            'data-record=\'' + safeRecord + '\'>' +
                            '<i class="fa fa-check"></i> Approve</button> ' +
                        '<button class="btn btn-sm btn-danger btn-reject" style="font-size:11px" ' +
                            'data-record=\'' + safeRecord + '\'>' +
                            '<i class="fa fa-times"></i> Reject</button>' +
                        '</div>';

                    var pendingLabels = ['Helper','Patient','Date','Check-In','Check-Out','Est. Hours',''];
                    var pendingCells  = [
                        item.helperName  || '—',
                        item.patientName || '—',
                        fmtDate(item.attendanceDate || item.checkInTime),
                        fmtDateTime(item.checkInTime),
                        fmtDateTime(item.checkOutTime),
                        estDisplay,
                        actions
                    ];
                    var pRow = table.row.add(pendingCells).draw();
                    $(pRow.node()).find('td').each(function (i) {
                        if (pendingLabels[i]) $(this).attr('data-label', pendingLabels[i]);
                    });
                });

                // Update pending count badge
                UpdatePendingBadge(response.data.length);
            },
            error: function (xhr, status, error) {
                console.error('[Attendance] GetPendingAttendance error:', error);
            }
        });
    }

    function LoadPendingCount() {
        $.ajax({
            url: '/Attendance/GetPendingAttendance', type: 'GET',
            success: function (res) { UpdatePendingBadge(res.data ? res.data.length : 0); }
        });
    }

    function UpdatePendingBadge(count) {
        if (count > 0) {
            $('#pendingCountBadge').text(count).prop('hidden', false);
        } else {
            $('#pendingCountBadge').prop('hidden', true);
        }
    }

    // ────────────────────────────────────────────────────────────────────────────
    // APPROVE / REJECT
    // ────────────────────────────────────────────────────────────────────────────
    function OpenApprovalModal(item, action) {
        console.log('[Approval] Opening modal — id:', item.attendanceId, 'action:', action);

        $('#amAttendanceId').val(item.attendanceId);
        $('#amAction').val(action);
        $('#amRemarks').val('');

        // Populate detail fields
        $('#amHelperName').text(item.helperName  || '—');
        $('#amPatientName').text(item.patientName || '—');
        $('#amDate').text(fmtDate(item.attendanceDate || item.checkInTime));
        $('#amCheckInTime').text(fmtDateTime(item.checkInTime));
        $('#amCheckOutTime').text(fmtDateTime(item.checkOutTime));

        var est = calcHours(item.checkInTime, item.checkOutTime);
        $('#amTotalHours').text(est !== null ? est + ' hrs (calculated on approval)' : '—');

        $('#amCheckInAddress').text(item.address    || '—');
        $('#amCheckInLatLon').text(
            (item.latitude  != null && item.longitude  != null)
                ? item.latitude.toFixed(5) + ', ' + item.longitude.toFixed(5) : '—');
        $('#amCheckInAccuracy').text(item.gpsAccuracy != null ? item.gpsAccuracy.toFixed(1) + ' m' : '—');

        $('#amCheckOutAddress').text(item.checkOutAddress || '—');
        $('#amCheckOutLatLon').text(
            (item.checkOutLatitude  != null && item.checkOutLongitude  != null)
                ? item.checkOutLatitude.toFixed(5) + ', ' + item.checkOutLongitude.toFixed(5) : '—');
        $('#amCheckOutAccuracy').text(
            item.checkOutGpsAccuracy != null ? item.checkOutGpsAccuracy.toFixed(1) + ' m' : '—');

        // Style modal header + confirm button based on action
        if (action === 'approve') {
            $('#ApprovalModalLabel').html('<i class="fa fa-check-circle" style="color:#5cb85c"></i> Approve Attendance');
            $('#approvalModalHeader').css('background-color', '#f0fff4');
            $('#btnConfirmApproval').removeClass('btn-danger').addClass('btn-success').text('Approve');
        } else {
            $('#ApprovalModalLabel').html('<i class="fa fa-times-circle" style="color:#d9534f"></i> Reject Attendance');
            $('#approvalModalHeader').css('background-color', '#fff5f5');
            $('#btnConfirmApproval').removeClass('btn-success').addClass('btn-danger').text('Reject');
        }

        $('#ApprovalModal').modal('show');
    }

    function SubmitApproval() {
        var id     = $('#amAttendanceId').val();
        var action = $('#amAction').val();
        var remarks = $('#amRemarks').val();
        var url    = action === 'approve'
                     ? '/Attendance/ApproveAttendance'
                     : '/Attendance/RejectAttendance';

        // approvedBy is resolved server-side from session — never sent by the client
        console.log('[Approval] Submitting — id:', id, 'action:', action);

        $('#btnConfirmApproval').prop('disabled', true)
                                .html('<i class="fa fa-spinner fa-spin"></i> Processing…');

        $.ajax({
            url: url, type: 'POST',
            data: { id: id, remarks: remarks },
            success: function (res) {
                console.log('[Approval] Response:', res);
                if (res.success) {
                    $('#ApprovalModal').modal('hide');
                    GetAttendanceData();
                    GetPendingData();
                    msgPopup(action === 'approve' ? 'success' : 'warning',
                             action === 'approve' ? 'Attendance Approved' : 'Attendance Rejected');
                } else {
                    Swal.fire({ icon: 'error', title: 'Action Failed', text: res.message });
                }
            },
            error: function (xhr) {
                console.error('[Approval] AJAX error:', xhr.status, xhr.responseText);
                Swal.fire({ icon: 'error', title: 'Error', text: 'An unexpected error occurred.' });
            },
            complete: function () {
                $('#btnConfirmApproval').prop('disabled', false)
                                        .text(action === 'approve' ? 'Approve' : 'Reject');
            }
        });
    }

    function confirmDelete(id) {
        $.confirm({
            title: 'Confirm',
            content: 'Are you sure you want to delete this record?',
            buttons: {
                Yes: { btnClass: 'btn btn-success', action: function () { deleteAttendance(id); } },
                No:  { btnClass: 'btn btn-warning',  action: function () { } }
            }
        });
    }

    function deleteAttendance(id) {
        $.ajax({
            type: 'POST', url: '/Attendance/DeleteAttendence', data: { id: id },
            success: function () {
                GetAttendanceData();
                if (localStorage.getItem('userRole') === 'admin') LoadPendingCount();
                alert('Record deleted successfully');
            },
            error: function () { alert('Error occurred deleting record'); }
        });
    }

    function HelpersDropDownList1() {
        // Server resolves identity from session — no userId sent by client.
        $.ajax({ url: '/Attendance/GetHelpers', type: 'GET',
            success: function (response) {
                var ddl = $('#ddlHelper').empty()
                    .append($('<option>', { value: '', text: 'Select Helper', selected: true }));
                $.each(response.data, function (i, item) {
                    ddl.append($('<option>', { value: item.id, text: item.name }));
                });
                // Non-admin: auto-select their assigned helper and lock the dropdown
                if (!response.isAdmin && response.data.length === 1) {
                    ddl.val(response.data[0].id).prop('disabled', true);
                }
            },
            error: function (xhr, status, error) { console.error("Error fetching Helpers Details:", error); }
        });
    }

    // Escapes a string for safe embedding in a JS string literal inside an HTML attribute
    function escJs(s) {
        return (s || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }
</script>
